#!/bin/bash
# Mock `brew` for testing brew-safe-install / brew-safe-upgrade.
# Reads canned responses from MOCK_BREW_DIR.
#
# Supported subcommands (just enough for the wrappers):
#   brew info --json=v2 [--formula] <name>
#   brew deps <name>                 — normalizes tap-qualified names (foo/bar/baz
#                                      -> deps_foo_bar_baz.txt) so a slash in the
#                                      name never becomes a path separator.
#   brew list --versions [--formula] <name>
#   brew install <args...>           — no-op success
#   brew update                      — no-op success
#   brew upgrade <args...>           — records the upgraded package names by
#                                      removing them from outdated.json, so a
#                                      later `brew outdated` reflects the upgrade
#                                      (the --self belt-and-suspenders re-check
#                                      depends on this being stateful).
#   brew outdated --json=v2          — returns outdated.json
#   brew pin/unpin <name>            — stateful (files under $DIR/pinned/)
#   brew list --pinned               — lists the pin store

DIR="${MOCK_BREW_DIR:-/dev/null}"

# Test seam: MOCK_BREW_FAIL=<subcommand> forces that subcommand to exit non-zero,
# so tests can exercise the wrappers' fail-closed paths (e.g. a brew deps /
# outdated / update failure must abort --self, never wave the upgrade through).
if [ -n "${MOCK_BREW_FAIL:-}" ] && [ "$1" = "$MOCK_BREW_FAIL" ]; then
    echo "mock brew: simulated failure for '$1'" >&2
    exit 1
fi

case "$1" in
    info)
        # last positional arg is the package name
        for arg in "$@"; do :; done
        NAME="$arg"
        F="$DIR/info_${NAME}.json"
        if [ -f "$F" ]; then
            cat "$F"
        else
            echo '{"formulae":[],"casks":[]}'
        fi
        ;;
    deps)
        # last positional arg is the package name. Normalize slashes so a
        # tap-qualified name (sharkyger/tap/safe-upgrade) maps to a flat filename.
        for arg in "$@"; do :; done
        NAME="$arg"
        NAME_NORM="$(printf '%s' "$NAME" | tr '/' '_')"
        F="$DIR/deps_${NAME_NORM}.txt"
        if [ -f "$F" ]; then cat "$F"; fi
        ;;
    formula)
        # `brew formula <user/tap/name>` → absolute path of the formula file in
        # the local tap clone. Canned in formula_<name with / → _>.txt; absent
        # means brew cannot resolve it (exit 1), and the wrapper falls back to
        # the canonical Formula/<name>.rb layout.
        for arg in "$@"; do :; done
        NAME="$arg"
        NAME_NORM="$(printf '%s' "$NAME" | tr '/' '_')"
        F="$DIR/formula_${NAME_NORM}.txt"
        if [ -f "$F" ]; then cat "$F"; else exit 1; fi
        ;;
    list)
        # `brew list --pinned` → names of the formulae currently pinned (one per
        # line), read from the stateful pin store so a test can assert the
        # wrapper left nothing pinned behind after an interrupted [s] run.
        for arg in "$@"; do
            if [ "$arg" = "--pinned" ]; then
                if [ -d "$DIR/pinned" ]; then
                    ls "$DIR/pinned" 2>/dev/null
                fi
                exit 0
            fi
        done
        # `brew list --versions --formula <name>` → installed versions
        for arg in "$@"; do :; done
        NAME="$arg"
        F="$DIR/list_${NAME}.txt"
        if [ -f "$F" ]; then cat "$F"; fi
        ;;
    outdated)
        F="$DIR/outdated.json"
        if [ -f "$F" ]; then
            cat "$F"
        else
            echo '{"formulae":[],"casks":[]}'
        fi
        ;;
    update)
        # Optionally emit Homebrew's harmless description-cache backtrace on stderr
        # (MOCK_BREW_UPDATE_NOISE=1) and/or an unrelated real warning
        # (MOCK_BREW_UPDATE_REALERR=1), so a test can assert noise is filtered while
        # genuine stderr passes through. `brew update` exits 0 in both cases.
        if [ -n "${MOCK_BREW_UPDATE_NOISE:-}" ]; then
            echo "Error: Cannot load descriptions cache." >&2
            echo "/opt/homebrew/Library/Homebrew/description_cache_store.rb:50:in \`each'" >&2
            echo "	from /opt/homebrew/Library/Homebrew/cmd/update.rb:120:in \`block'" >&2
        fi
        if [ -n "${MOCK_BREW_UPDATE_REALERR:-}" ]; then
            echo "Warning: a genuine update warning you should still see" >&2
        fi
        exit 0
        ;;
    upgrade)
        # Test seam: MOCK_BREW_UPGRADE_SLEEP holds the upgrade open so a test can
        # interrupt the wrapper while brew is "running".
        if [ -n "${MOCK_BREW_UPGRADE_SLEEP:-}" ]; then
            sleep "$MOCK_BREW_UPGRADE_SLEEP"
        fi
        # Stateful: drop the upgraded package(s) from outdated.json so a later
        # `brew outdated` no longer lists them. This models "after upgrade, no
        # longer outdated" — required for the --self belt-and-suspenders re-check
        # (deps gated & upgraded first must read as clean before the formula
        # upgrade). Matches on full name or basename so tap-qualified args work.
        OUTF="$DIR/outdated.json"
        if [ -f "$OUTF" ]; then
            pkgs=""
            for a in "$@"; do
                case "$a" in
                    upgrade | --*) ;;
                    *) pkgs="$pkgs $a" ;;
                esac
            done
            if [ -n "$pkgs" ]; then
                PKGS="$pkgs" OUTF="$OUTF" python3 -c '
import os, json
outf = os.environ["OUTF"]
# Match on basename in BOTH directions so a tap-qualified upgrade arg
# (sharkyger/tap/foo) drops a bare outdated entry (foo) and vice-versa.
upg = {u.split("/")[-1] for u in os.environ["PKGS"].split()}
try:
    with open(outf) as f:
        d = json.load(f)
    for key in ("formulae", "casks"):
        d[key] = [
            x for x in d.get(key, [])
            if x.get("name", "").split("/")[-1] not in upg
        ]
    with open(outf, "w") as f:
        json.dump(d, f)
except Exception:
    pass
' 2>/dev/null
            fi
        fi
        exit 0
        ;;
    pin | unpin)
        # Test seam: MOCK_PIN_LOG records pin/unpin calls so a test can assert
        # that a flagged dependency really was pinned for the duration of the
        # upgrade (the mechanism that stops brew resolving it in anyway).
        _cmd="$1"
        shift
        if [ -n "${MOCK_PIN_LOG:-}" ]; then
            # One line per package: real `brew pin` accepts several at once, and
            # logging only $2 would hide everything after the first.
            for _pkg in "$@"; do
                echo "$_cmd $_pkg" >>"$MOCK_PIN_LOG"
            done
        fi
        # Stateful pin store: `brew list --pinned` reads it back. Pre-existing
        # pins are staged by a test as files under $DIR/pinned/ before the run.
        mkdir -p "$DIR/pinned" 2>/dev/null
        for _pkg in "$@"; do
            case "$_pkg" in --*) continue ;; esac
            if [ "$_cmd" = "pin" ]; then
                : >"$DIR/pinned/$_pkg"
            else
                # Test seam: MOCK_BREW_UNPIN_SLEEP slows each unpin so a test can
                # deliver SIGINT while the wrapper is INSIDE its unpin loop — the
                # worst case, which strands the Held set (unpinned last).
                if [ -n "${MOCK_BREW_UNPIN_SLEEP:-}" ]; then
                    sleep "$MOCK_BREW_UNPIN_SLEEP"
                fi
                rm -f "$DIR/pinned/$_pkg"
            fi
        done
        exit 0
        ;;
    install)
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
