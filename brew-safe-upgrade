#!/bin/bash
#:  `brew safe-upgrade` [options] [package ...]
#:
#:  Security-first `brew upgrade`. Checks every outdated package (and its
#:  incoming dependencies) against OSV.dev, the GitHub Advisory Database, and
#:  NIST NVD before upgrading. Fail-closed.
#:
#:      [package ...]          Restrict the run to the named outdated package(s)
#:                             instead of every outdated package.
#:      -y, --yes              Auto-approve the upgrade (non-interactive).
#:      --min-age N            Hold packages published less than N days ago
#:                             (default: 3; 0 disables the freshness hold).
#:      --allow-unknown-age    Permit packages whose age cannot be verified
#:                             (default: held — fail closed). Also proceeds when
#:                             the GitHub API rate limit blocks the age check.
#:      --no-verify-sha        Skip bottle SHA verification (default: on).
#:      --no-deps              Skip transitive dependency checking.
#:      --skip-unsafe          When an incoming dependency is flagged, hold only
#:                             the packages that depend on it and upgrade the
#:                             rest, instead of cancelling the whole run.
#:      --self                 Upgrade safe-upgrade itself THROUGH this gate
#:                             (Homebrew formula install only; the script install
#:                             uses `brew safe-update`).
#:      --version              Print version, install route, helper status.
#:      -h, --help             Show this help and exit.
#:
#:  The age check queries GitHub's API (60 requests/hour unauthenticated). Set
#:  `gh auth login` or HOMEBREW_GITHUB_API_TOKEN for 5000/hour (GH_TOKEN and
#:  GITHUB_TOKEN work only outside `brew`, which scrubs the environment).
#:
#:  NOTE: Homebrew intercepts -h/--help/--usage/-? before exec'ing this script
#:  and renders help from these `#:` lines. The print_help() block below serves
#:  direct invocation (and the test suite). Keep the two in sync.
# brew-safe-upgrade — checks outdated Homebrew packages AND their incoming
# dependencies for known vulnerabilities before upgrading.
# Queries 3 databases: OSV.dev, GitHub Advisory, NIST NVD.
#
# Usage: brew safe-upgrade [--yes|-y] [--min-age N] [--allow-unknown-age]
#                          [--no-verify-sha] [--no-deps] [--skip-unsafe]
#                          [--version] [-h|--help] [package ...]
#        [package ...]  Restrict the run to the named outdated package(s) instead
#                       of every outdated package (matches name or basename).
#        --allow-unknown-age  Permit packages whose release age cannot be verified
#                             (default: such packages are HELD — fail closed)
#        --version  Print version, install route, and helper-file status (self-diagnosis)
#        -h, --help Show usage (flag listing + description) and exit
#
# Environment:
#        BREW_SAFE_NO_DEPS=1     Same as --no-deps (handy for CI / aliases)
#        MOCK_FORMULAE_API_DIR   (test only) read canonical responses from this dir
#                                instead of curling https://formulae.brew.sh
#        MOCK_INTERACTIVE_MODE=1 (test only) force the interactive prompt branch
#                                even when stdin is not a TTY

set -uo pipefail

# Locate the security check script relative to this script.
# DEPENDENCY_SECURITY_CHECK env var overrides the path (used by the test suite
# to inject a stub; production users should leave it unset).
#
# Resolve THIS script's real directory, following symlinks. Portable: macOS has
# no `readlink -f`, so we walk the symlink chain by hand. This makes the helper
# lookup work whether the script is a real file in bin (script install), a
# Homebrew symlink into libexec, or a relocated copy — on either architecture.
resolve_script_dir() {
    local src="${BASH_SOURCE[0]}" dir
    while [ -h "$src" ]; do
        dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
        src="$(readlink "$src")"
        case "$src" in
            /*) ;;
            *) src="$dir/$src" ;;
        esac
    done
    cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}
SCRIPT_DIR="$(resolve_script_dir)"
SCRIPT="${DEPENDENCY_SECURITY_CHECK:-$SCRIPT_DIR/dependency_security_check.py}"
# Host-aware bottle-SHA resolver (picks the tag matching this Mac's arch + OS).
# BREW_SAFE_BOTTLE_RESOLVER overrides the path for the test suite.
BOTTLE_RESOLVER="${BREW_SAFE_BOTTLE_RESOLVER:-$SCRIPT_DIR/bottle_resolver.py}"

# --version / self-diagnosis. Handled BEFORE the helper guards so it still works
# (and explains itself) when a helper is missing. Version is read from the single
# VERSION file shipped alongside the scripts — one source, no per-script drift.
SAFE_UPGRADE_VERSION="$(cat "$SCRIPT_DIR/VERSION" 2>/dev/null || echo "unknown")"
print_version() {
    echo "brew-safe-upgrade $SAFE_UPGRADE_VERSION"
    case "$SCRIPT_DIR" in
        */libexec | */libexec/* | */Cellar/*) echo "install route: Homebrew formula ($SCRIPT_DIR)" ;;
        *) echo "install route: script ($SCRIPT_DIR)" ;;
    esac
    local missing=""
    for h in dependency_security_check.py bottle_resolver.py cask_nvd_map.py formula_cpe_map.py; do
        [ -f "$SCRIPT_DIR/$h" ] || missing="$missing $h"
    done
    if [ -n "$missing" ]; then
        echo "helpers: MISSING -$missing"
        echo "  -> run 'brew safe-update' to re-fetch all helpers (or re-run install.sh)"
    else
        echo "helpers: all present"
    fi
    # Collision: a second brew-safe-upgrade on PATH (script install + formula both
    # present) can shadow this one and confuse updates. Warn if more than one.
    local n
    n="$(type -aP brew-safe-upgrade 2>/dev/null | sort -u | grep -c .)"
    if [ "${n:-0}" -gt 1 ]; then
        echo "warning: multiple brew-safe-upgrade on PATH — both install routes may be present:"
        type -aP brew-safe-upgrade 2>/dev/null | sort -u | sed 's/^/  /'
        echo "  keep one route (formula OR script); see README 'Install'."
    fi
}

# --help. Handled alongside --version, BEFORE the helper guards, so `--help`
# answers even when a helper file is missing (issue #66).
print_help() {
    cat <<'EOF'
brew safe-upgrade — security-first `brew upgrade`

Checks every outdated package (and its incoming dependencies) against OSV.dev,
the GitHub Advisory Database, and NIST NVD before upgrading. Fail-closed.

Usage: brew safe-upgrade [options] [package ...]

  [package ...]          Restrict the run to the named outdated package(s)
                         instead of every outdated package.

Options:
  -y, --yes              Auto-approve the upgrade (non-interactive).
  --min-age N            Hold packages published less than N days ago
                         (default: 3; --min-age 0 disables the freshness hold).
  --allow-unknown-age    Permit packages whose release age cannot be verified
                         (default: such packages are HELD — fail closed). Also
                         lets the run proceed when the GitHub API rate limit
                         blocks the age check.
  --no-verify-sha        Skip bottle SHA verification (default: ON).
  --no-deps              Skip transitive dependency checking (default: check).
  --skip-unsafe          When an incoming dependency is flagged (CVE or below
                         --min-age), hold back only the packages that depend on
                         it and upgrade the rest, instead of cancelling the
                         whole run. Interactively this is the [s] answer.
  --self                 Upgrade safe-upgrade itself THROUGH this security gate:
                         gate its outdated dependencies first (fail-closed), then
                         upgrade the formula. Homebrew formula install only; the
                         script install uses `brew safe-update`.
  --version              Print version, install route, and helper-file status.
  -h, --help             Show this help and exit.

The age check queries GitHub's API, which is rate-limited to 60 requests/hour
for unauthenticated requests. Authenticate for 5000/hour: set GH_TOKEN or
GITHUB_TOKEN, or run `gh auth login` (the gh CLI token is used automatically).
When the limit is hit, the run aborts with the reset time unless
--allow-unknown-age is passed.

Environment:
  BREW_SAFE_NO_DEPS=1    Same as --no-deps.
  GH_TOKEN / GITHUB_TOKEN
                         GitHub token for the age check (raises the API limit to
                         5000/hour). Falls back to `gh auth token` if unset.

Examples:
  brew safe-upgrade                  # check & upgrade everything outdated
  brew safe-upgrade openssl@3 curl   # restrict to these packages
  brew safe-upgrade --yes            # no confirmation prompt
EOF
}
case " $* " in
    *" --help "* | *" -h "*)
        print_help
        exit 0
        ;;
    *" --version "*)
        print_version
        exit 0
        ;;
esac

# Fail closed: a missing resolver would make every SHA read empty -> the bottle
# integrity check would silently no-op. Refuse to run instead.
if [ ! -f "$BOTTLE_RESOLVER" ]; then
    echo "Error: bottle SHA resolver not found at $BOTTLE_RESOLVER"
    echo "A required helper (bottle_resolver.py) is missing from your install."
    echo "Fix: run 'brew safe-update' to re-fetch all helpers (or re-run install.sh)."
    exit 2
fi

AUTO_YES=false
SKIP_UNSAFE=false       # --skip-unsafe: hold packages with a flagged dep, upgrade the rest (#98).
DEP_PARTIAL=false       # Set when we upgrade only the unaffected subset.
DEP_HELD_PKGS=""        # Packages held back because a dependency was flagged.
MIN_AGE=3               # 3-day freshness hold; --min-age 0 to disable.
ALLOW_UNKNOWN_AGE=false # Fail closed: hold packages whose age can't be verified.
VERIFY_SHA=true         # Default-on as of v0.2.0 — opt out with --no-verify-sha.
CHECK_DEPS=true
TARGET_PKGS=""          # Positional package names (#61): restrict the run to these.
SELF_UPGRADE_MODE=false # --self: upgrade safe-upgrade itself through the gate (#87).
# The tap formula to self-upgrade. Overridable so the test suite can point at a
# mock formula; production users never set this.
SELF_FORMULA="${BREW_SAFE_SELF_FORMULA:-sharkyger/tap/safe-upgrade}"
case "${BREW_SAFE_NO_DEPS:-}" in
    1 | true | TRUE | yes | YES) CHECK_DEPS=false ;;
esac

while [[ $# -gt 0 ]]; do
    case "$1" in
        --yes | -y)
            AUTO_YES=true
            shift
            ;;
        --min-age)
            # Require an explicit value: a bare `--min-age` (no arg) would
            # otherwise `shift 2` past the end, never consume the flag, and loop
            # forever. Reject a missing or flag-like value up front.
            if [[ -z "${2:-}" || "$2" == -* ]]; then
                echo "Error: --min-age requires a numeric argument (days)" >&2
                exit 2
            fi
            MIN_AGE="$2"
            shift 2
            ;;
        --allow-unknown-age)
            ALLOW_UNKNOWN_AGE=true
            shift
            ;;
        --skip-unsafe)
            SKIP_UNSAFE=true
            shift
            ;;
        --verify-sha) shift ;; # Accepted for back-compat — verification is now on by default.
        --no-verify-sha)
            VERIFY_SHA=false
            shift
            ;;
        --no-deps)
            CHECK_DEPS=false
            shift
            ;;
        --self)
            SELF_UPGRADE_MODE=true
            shift
            ;;
        -*) shift ;; # Unknown flags: ignore (forward-compat).
        *)
            TARGET_PKGS="$TARGET_PKGS $1"
            shift
            ;;
    esac
done

# Resolve a GitHub API token ONCE per run. The age check queries GitHub's
# commits API, which allows only 60 requests/hour unauthenticated (per IP) vs
# 5000/hour authenticated — so a busy machine exhausts the anonymous quota and
# every age lookup then fails (issue #84). Priority: $GH_TOKEN, then
# $GITHUB_TOKEN, then an authenticated `gh` CLI. Empty when none are available
# (requests stay anonymous and still work, just rate-limited). Resolved here,
# before the per-package loop, so `gh auth token` runs at most once.
resolve_gh_token() {
    if [ -n "${GH_TOKEN:-}" ]; then
        printf '%s' "$GH_TOKEN"
    elif [ -n "${GITHUB_TOKEN:-}" ]; then
        printf '%s' "$GITHUB_TOKEN"
    elif [ -n "${HOMEBREW_GITHUB_API_TOKEN:-}" ]; then
        # The only spelling that survives `brew`. Homebrew re-execs external
        # commands through `env -i` with an allowlist (bin/brew) that keeps
        # HOMEBREW_* and drops everything else — so GH_TOKEN and GITHUB_TOKEN
        # exported in a shell profile never reach us when invoked as
        # `brew safe-upgrade`. This is Homebrew's own documented token variable
        # (Library/Homebrew/env_config.rb), so most users who need it have it.
        printf '%s' "$HOMEBREW_GITHUB_API_TOKEN"
    elif command -v gh >/dev/null 2>&1; then
        # stderr suppressed: never prompt, never fail the run if gh is unauthed.
        gh auth token 2>/dev/null || true
    fi
}
GH_AUTH_TOKEN="$(resolve_gh_token)"

# ---------------------------------------------------------------------------
# Age-resolution cache + ghcr.io bottle dates
#
# Issue #84 raised the GitHub API ceiling by authenticating. This addresses the
# call VOLUME, which is the part that breaks on real machines: fetch_pkg_age
# spends one GitHub request per outdated package, and anonymous REST allows 60
# per hour per IP. A machine left un-upgraded for a few weeks routinely has
# 50-70 outdated packages, so the FIRST run can exhaust the quota, and a second
# run within the hour always does. The gate then fails closed on everything and
# the user upgrades nothing — the worst outcome for the machines that are
# furthest behind.
#
# Two changes remove most of that traffic:
#
#   1. A publication date is IMMUTABLE. Once pandoc 3.10.2 is dated 2026-08-13
#      it is dated that forever, so (type,name,version) -> timestamp is cached
#      on disk and re-runs cost zero requests.
#   2. Homebrew publishes core bottles to ghcr.io as OCI artifacts whose index
#      carries org.opencontainers.image.created. Anonymous ghcr reads are not
#      metered against the 60/hour REST budget, so core formulae resolve for
#      free and GitHub is left to handle only casks and tap formulae.
#
# On accuracy: the GitHub date is the last commit to TOUCH the formula file,
# which is not the release date. homebrew-core lands a version bump and its
# bottle hashes as two commits ("python@3.14 3.14.7" on 2026-08-09, then
# "python@3.14: update 3.14.7 bottle." on 2026-08-13), and unrelated
# maintenance commits move it too. per_page=1 returns whichever came last. The
# ghcr annotation is the bottle build time — the moment the artifact a user
# would actually download became public, which is what a freshness hold is
# trying to measure.
#
# On trust: ONLY homebrew-core is read from ghcr. Those manifests are pushed by
# Homebrew's CI alone. A third-party tap owner controls their own annotations
# and could backdate one to slip past --min-age, so taps keep using the commit
# date, which is attested by GitHub rather than self-reported by the publisher.
# Casks have no bottles and are unaffected.
# ---------------------------------------------------------------------------

# Cache location. Honors an explicit override first (tests), then Homebrew's own
# cache root, then the platform default — Homebrew runs on Linux too, where
# ~/Library does not exist.
AGE_CACHE_ENABLED=true
if [ -n "${BREW_SAFE_AGE_CACHE_DIR:-}" ]; then
    AGE_CACHE_DIR="$BREW_SAFE_AGE_CACHE_DIR"
elif [ -n "${MOCK_COMMITS_API_DIR:-}" ]; then
    # Hermetic test mode. Without this a date resolved by one test would persist
    # in the user's real cache and leak into the next — and into their next real
    # run. Tests that want cache behaviour set BREW_SAFE_AGE_CACHE_DIR explicitly.
    AGE_CACHE_ENABLED=false
    AGE_CACHE_DIR=""
elif [ -n "${HOMEBREW_CACHE:-}" ]; then
    AGE_CACHE_DIR="${HOMEBREW_CACHE}/safe-upgrade-age"
elif [ -n "${HOME:-}" ] && [ -d "${HOME}/Library/Caches" ]; then
    # The -n guard matters: with HOME unset, -d "/Library/Caches" is still true
    # on macOS (it exists at the filesystem root) and the branch would then
    # expand an unbound $HOME.
    AGE_CACHE_DIR="${HOME}/Library/Caches/homebrew-safe-upgrade/age"
elif [ -n "${XDG_CACHE_HOME:-}" ]; then
    AGE_CACHE_DIR="${XDG_CACHE_HOME}/homebrew-safe-upgrade/age"
elif [ -n "${HOME:-}" ]; then
    # Kept flat rather than ${XDG_CACHE_HOME:-${HOME}/.cache}: bash 3.2, which
    # is what ships with macOS, expands the nested default eagerly and trips
    # `set -u` when HOME is unset.
    AGE_CACHE_DIR="${HOME}/.cache/homebrew-safe-upgrade/age"
else
    # No usable home (some CI and test harnesses): run without a cache rather
    # than dying under `set -u`.
    AGE_CACHE_ENABLED=false
    AGE_CACHE_DIR=""
fi

# Cache key for one resolved package version. Folding separators into '_' is
# NOT injective — `core:zlib@1.3_1` and `core:zlib_1.3@1` would share a file, and
# a stale date under a shared key could wave a brand-new package past --min-age.
# Hash the three fields with a delimiter that cannot appear in any of them.
age_cache_key() {
    printf '%s\n%s\n%s\n' "$1" "$2" "$3" | python3 -c "
import sys, hashlib
print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())
" 2>/dev/null
}

# Echo the timestamp if it parses as a complete ISO-8601 datetime, else return 1.
# Shared by every path that admits a date into the cache or a decision, so a
# malformed registry annotation or cache file cannot become a persistent
# "-1 unknown" hold — it degrades to the next resolver instead.
valid_iso() {
    python3 -c "
import sys, datetime
v = sys.argv[1]
try:
    datetime.datetime.fromisoformat(v.replace('Z', '+00:00'))
except Exception:
    sys.exit(1)
print(v)
" "$1" 2>/dev/null
}

# Echo the cached ISO timestamp for a key, or return 1. The stored value is
# re-validated on read: a truncated or hand-edited cache file must degrade to a
# live lookup, never inject a bogus date into a security decision.
age_cache_get() {
    local f="$AGE_CACHE_DIR/$1" v
    [ "$AGE_CACHE_ENABLED" = true ] || return 1
    [ -f "$f" ] || return 1
    v=$(cat "$f" 2>/dev/null) || return 1
    valid_iso "$v"
}

# Store a resolved ISO timestamp. Best-effort: a read-only or full cache dir
# must never fail the run, it just means the next run pays for the lookup again.
age_cache_put() {
    [ "$AGE_CACHE_ENABLED" = true ] || return 0
    [ -n "${1:-}" ] && [ -n "${2:-}" ] || return 0
    mkdir -p "$AGE_CACHE_DIR" 2>/dev/null || return 0
    printf '%s\n' "$2" >"$AGE_CACHE_DIR/$1" 2>/dev/null || true
}

# Render an ISO timestamp as the "<age_days> <YYYY-MM-DD>" contract shared by
# every fetch_pkg_age return path.
age_from_iso() {
    python3 -c "
import sys, datetime
try:
    dt = datetime.datetime.fromisoformat(sys.argv[1].replace('Z', '+00:00'))
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=datetime.timezone.utc)
    age = (datetime.datetime.now(datetime.timezone.utc) - dt).days
    print(f'{age} {dt.strftime(\"%Y-%m-%d\")}')
except Exception:
    print('-1 unknown')
" "$1" 2>/dev/null
}

# Bottle publication timestamp for a homebrew-core formula, read from the OCI
# image index on the Homebrew bottle registry. Echoes an ISO timestamp, or
# nothing when the bottle, the tag, or the annotation is absent (source-only
# formulae, brand-new versions) — every such case falls back to the GitHub path.
#
# Test seam: MOCK_GHCR_DIR holds one file per "<name>@<version>" ('/' and '@'
# folded to '_') containing the manifest JSON; a missing file means "no bottle".
BOTTLE_REGISTRY="${BREW_SAFE_BOTTLE_REGISTRY:-https://ghcr.io}"
fetch_ghcr_date() {
    local name="$1" ver="$2" repo tok mf key
    [ -n "$ver" ] || return 0

    if [ -n "${MOCK_GHCR_DIR:-}" ]; then
        key=$(printf '%s' "${name}@${ver}" | tr '/@' '__')
        [ -f "$MOCK_GHCR_DIR/${key}.json" ] || return 0
        mf=$(cat "$MOCK_GHCR_DIR/${key}.json")
    elif [ -n "${MOCK_COMMITS_API_DIR:-}" ]; then
        # Mock mode with no registry fixture: report "no bottle" so the test
        # exercises the commit-date path instead of reaching the network.
        return 0
    else
        # Versioned formulae map '@' to a path segment: python@3.14 lives at
        # homebrew/core/python/3.14.
        repo="homebrew/core/$(printf '%s' "$name" | tr '@' '/')"
        tok=$(curl -s --max-time 10 \
            "${BOTTLE_REGISTRY}/token?service=ghcr.io&scope=repository:${repo}:pull" 2>/dev/null |
            python3 -c "import sys,json;print(json.load(sys.stdin).get('token',''))" 2>/dev/null)
        [ -n "$tok" ] || return 0
        mf=$(curl -s --max-time 10 \
            -H "Authorization: Bearer ${tok}" \
            -H "Accept: application/vnd.oci.image.index.v1+json" \
            "${BOTTLE_REGISTRY}/v2/${repo}/manifests/${ver}" 2>/dev/null) || return 0
    fi

    local created
    created=$(printf '%s' "$mf" | python3 -c "
import sys, json
try:
    print(json.load(sys.stdin).get('annotations', {}).get('org.opencontainers.image.created', ''))
except Exception:
    print('')
" 2>/dev/null)
    # A malformed annotation is "no bottle metadata", not a date: fall through to
    # the commit-date path rather than caching something that never parses.
    if [ -n "$created" ]; then
        valid_iso "$created" || true
    fi
}

# Resolve the release age (in days) of a package's current formula/cask file by
# reading the last-commit date from the *correct* Homebrew GitHub repo for its
# type. Routing this by type is the fix for the fail-open bug: casks live in
# homebrew-cask and tap formulae in their own tap repo — querying homebrew-core
# for them returns [] and used to be treated as "age unknown → skip".
#   $1 = lookup name (core formula name, cask token, or full tap path user/tap/name)
#   $2 = type: core | cask | tap
# Echoes one of:
#   "<age_days> <YYYY-MM-DD>"   resolved age
#   "-1 unknown"                age could not be resolved -> hold (fail closed)
#   "-2 ratelimited <reset>"    GitHub API rate limit hit; <reset> = epoch seconds
#                               (0 if unknown) -> callers abort unless --allow-unknown-age
# Callers MUST treat "-1"/"-2" as "could not verify", never as "ok" (fail closed).
# Test seams: MOCK_COMMITS_API_DIR (canned JSON per name, '/'→'_' in filenames;
# falls back to _default.json, else []; a body starting with "__RATELIMIT__"
# simulates a rate-limit, optional trailing epoch) and MOCK_COMMITS_API_LOG
# (appends "<type>\t<url>" so tests can assert correct-repo routing).
fetch_pkg_age() {
    local name="$1" ptype="$2" url first user tap token json key
    local ver="${3:-}" ckey="" cached iso ghcr_iso

    # Cache and the bottle registry both key on an exact version. Dependency
    # lookups do not carry one, so they fall straight through to the commit-date
    # path and behave exactly as before.
    if [ -n "$ver" ]; then
        ckey=$(age_cache_key "$ptype" "$name" "$ver")
        if cached=$(age_cache_get "$ckey"); then
            age_from_iso "$cached"
            return
        fi
        if [ "$ptype" = "core" ]; then
            ghcr_iso=$(fetch_ghcr_date "$name" "$ver")
            if [ -n "$ghcr_iso" ]; then
                age_cache_put "$ckey" "$ghcr_iso"
                age_from_iso "$ghcr_iso"
                return
            fi
        fi
    fi
    case "$ptype" in
        cask)
            first=$(printf '%s' "$name" | cut -c1)
            url="https://api.github.com/repos/Homebrew/homebrew-cask/commits?path=Casks/${first}/${name}.rb&per_page=1"
            ;;
        tap)
            # user/tap/name -> repo <user>/homebrew-<tap>. The formula's path
            # INSIDE that repo is whatever the tap chose: Homebrew permits
            # Formula/, HomebrewFormula/ and the repo root (shopify/homebrew-
            # shopify keeps shopify-cli.rb at the root). Guessing Formula/
            # returned [] for such taps -> "age could not be verified" on every
            # run. brew already knows the real path because the tap is cloned
            # locally: `brew formula user/tap/name` prints it. Strip the local
            # prefix through Taps/<user>/homebrew-<tap>/ and what remains is the
            # repo-relative path — derived from brew's OUTPUT, never rebuilt
            # from the spec, because the prefix differs per machine
            # (/usr/local vs /opt/homebrew). Canonical layout stays the fallback
            # when brew cannot answer (no local clone); an unknown layout still
            # resolves to [] -> unknown -> held (fail closed).
            user="${name%%/*}"
            tap="${name#*/}"
            tap="${tap%%/*}"
            token="${name##*/}"
            rel="Formula/${token}.rb"
            if fpath=$(brew formula "$name" 2>/dev/null) && [ -n "$fpath" ]; then
                case "$fpath" in
                    */Taps/"${user}"/homebrew-"${tap}"/*)
                        rel="${fpath#*/Taps/"${user}"/homebrew-"${tap}"/}"
                        ;;
                esac
            fi
            url="https://api.github.com/repos/${user}/homebrew-${tap}/commits?path=${rel}&per_page=1"
            ;;
        *)
            # homebrew-core shards by first letter, EXCEPT formulae whose name
            # starts with "lib" live under Formula/lib/ (the repo's one multi-char
            # shard). Using Formula/l/ for them returns [] → "unknown" → the very
            # fail-open this fixes (see issue #62: libgit2, libheif, libusb, …).
            case "$name" in
                lib*) first="lib" ;;
                *) first=$(printf '%s' "$name" | cut -c1) ;;
            esac
            url="https://api.github.com/repos/Homebrew/homebrew-core/commits?path=Formula/${first}/${name}.rb&per_page=1"
            ;;
    esac

    [ -n "${MOCK_COMMITS_API_LOG:-}" ] && printf '%s\t%s\n' "$ptype" "$url" >>"$MOCK_COMMITS_API_LOG"

    if [ -n "${MOCK_COMMITS_API_DIR:-}" ]; then
        key=$(printf '%s' "$name" | tr '/' '_')
        if [ -f "$MOCK_COMMITS_API_DIR/${key}.json" ]; then
            json=$(cat "$MOCK_COMMITS_API_DIR/${key}.json")
        elif [ -f "$MOCK_COMMITS_API_DIR/_default.json" ]; then
            json=$(cat "$MOCK_COMMITS_API_DIR/_default.json")
        else
            json="[]"
        fi
        # Test seam: a "__RATELIMIT__ [epoch]" body simulates a 403/429 without
        # needing real curl/headers (the mock dir bypasses curl entirely).
        case "$json" in
            __RATELIMIT__*)
                printf '%s\n' "-2 ratelimited $(printf '%s' "$json" | tr -dc '0-9')"
                return
                ;;
        esac
    else
        # Capture body, HTTP status, and rate-limit headers (mirrors the bottle
        # SHA-verify pattern below). Authenticated when a token was resolved —
        # the header goes in an array so the value is passed as ONE argument (no
        # word-splitting); the nounset guard keeps an empty array safe under
        # `set -u` on bash 3.2 (macOS), matching the INCOMING_DEPS_ARR idiom.
        local hdr body http reset remaining
        local auth=()
        [ -n "$GH_AUTH_TOKEN" ] && auth=(-H "Authorization: Bearer $GH_AUTH_TOKEN")
        hdr=$(mktemp)
        body=$(mktemp)
        http=$(curl -s -o "$body" -D "$hdr" -w "%{http_code}" --max-time 10 \
            -H "Accept: application/vnd.github+json" \
            -H "X-GitHub-Api-Version: 2022-11-28" \
            ${auth[@]+"${auth[@]}"} \
            "$url" 2>/dev/null || echo "000")
        json=$(cat "$body" 2>/dev/null || echo "[]")
        reset=$(grep -i '^x-ratelimit-reset:' "$hdr" | tr -dc '0-9')
        remaining=$(grep -i '^x-ratelimit-remaining:' "$hdr" | tr -dc '0-9')
        rm -f "$hdr" "$body"
        # GitHub signals a primary rate limit with HTTP 403/429 AND
        # x-ratelimit-remaining: 0. Distinguish it from a real "unknown age" so
        # the caller can abort with the reset time instead of silently holding.
        if { [ "$http" = "403" ] || [ "$http" = "429" ]; } && [ "${remaining:-x}" = "0" ]; then
            printf '%s\n' "-2 ratelimited ${reset:-0}"
            return
        fi
    fi

    iso=$(printf '%s' "$json" | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    print((data[0]['commit']['committer']['date'] or '') if data else '')
except Exception:
    print('')
" 2>/dev/null)

    if [ -n "$iso" ] && iso=$(valid_iso "$iso"); then
        age_cache_put "$ckey" "$iso"
        age_from_iso "$iso"
    else
        printf '%s\n' "-1 unknown"
    fi
}

# Abort the run on a GitHub API rate limit (issue #84). $1 = the fetch_pkg_age
# "-2 ratelimited <epoch>" verdict (reset epoch is field 3); $2 = optional
# context phrase for the first line (e.g. " for dependency foo"). Converts the
# reset epoch to local time with stdlib python; omits it when unknown (0).
rate_limit_abort() {
    local reset when
    reset=$(printf '%s' "$1" | awk '{print $3}')
    when=$(python3 -c "import sys, datetime as d
e = int(sys.argv[1] or 0)
print(' (resets ' + d.datetime.fromtimestamp(e).strftime('%H:%M local time') + ')' if e > 0 else '')" "$reset" 2>/dev/null)
    echo ""
    echo "ERROR: GitHub API rate limit reached during age check${2:-}${when}."
    echo "Authenticated requests allow 5000/hour (anonymous: 60). To continue:"
    echo "  • run: gh auth login   (works under \`brew\`: the token is read from disk)"
    echo "  • or export HOMEBREW_GITHUB_API_TOKEN=<token>   (survives \`brew\`)"
    echo "  • GH_TOKEN / GITHUB_TOKEN work only outside \`brew\`, which scrubs them"
    echo "  • or re-run with --allow-unknown-age to skip age verification"
    exit 1
}

# `brew update` intermittently dumps a harmless Ruby backtrace from its own
# description cache (DescriptionCacheStore) on stderr. It self-heals (a later
# `brew update-reset` clears it) and does NOT affect the update — but dumping
# brew internals mid-run looks alarming. filter_brew_update_noise drops exactly
# those lines and passes everything else (real warnings/errors) straight through.
# Pure (reads stdin, writes stdout) so it is unit-testable without invoking brew.
filter_brew_update_noise() {
    grep -viE 'DescriptionCacheStore|description_cache_store|[Cc]annot load (the )?descriptions? cache|\.rb:[0-9]+:in |^[[:space:]]*from .*\.rb:[0-9]+' || true
}

run_brew_update() {
    local err rc
    err="$(mktemp)"
    brew update --quiet 2>"$err"
    rc=$?
    # Re-emit stderr minus the known-harmless description-cache backtrace.
    filter_brew_update_noise <"$err" >&2
    rm -f "$err"
    return "$rc"
}

# One-line "SEV CVE-id" summary of the worst finding in a verdict ($1), for the
# end-of-run blocked-dependency reasons. Reads the JSON: the verdict is captured
# with 2>/dev/null, so the scanner's human-readable stderr lines are not there to
# grep. A grep over the JSON matched the single dump line and printed the entire
# document into the summary.
first_vuln_summary() {
    echo "$1" | python3 -c "
import sys, json
try:
    v = sorted(json.load(sys.stdin).get('vulnerabilities', []),
               key=lambda x: (-(x.get('score') or 0), x.get('id', '')))
    if v:
        # Same scope marker as print_vuln_lines: a dependency blocked solely by
        # an unscoped finding taints every dependent, so the end-of-run reason
        # must not imply a version-pinned vulnerability it cannot support.
        scope = ' (no version scope)' if v[0].get('scoped') is False else ''
        print(f\"{v[0].get('severity','?')} {v[0].get('id','?')}{scope}\")
except Exception:
    pass
" 2>/dev/null || true
}

# True when the parsed installed version is a real version rather than the "?"
# the outdated parser emits for an entry with no usable installed_versions.
#
# "?" must never reach the scanner as if it were a version. parse_version()
# returns None for it, and version_in_range() answers True — "affected" — for
# every advisory it cannot parse against, by design (fail closed when scanning a
# CANDIDATE). Fed the INSTALLED side that same rule inverts: the baseline comes
# back carrying every CVE in the database, which
#   - makes the freshness bypass fire ("installed ? has CVEs"), waving a
#     same-day release past --min-age, and
#   - makes the candidate's findings a subset of the baseline's, so [SAME] /
#     [IMPROVES] clears a package that genuinely regressed.
# Both are the exact fail-open this file has twice been fixed for. An unknown
# installed version is not a vulnerable one — it is no baseline at all, and the
# comparison has to be skipped rather than guessed.
# HEAD* is rejected here as well as filtered in the parser above. Belt and
# braces on purpose: this guard is the last thing standing between an
# unparseable version and a scanner call that would read it as "affected by
# everything", and the same hole has now been reached by three different
# spellings ('?', a JSON null, and a HEAD keg).
installed_version_known() {
    case "${1:-}" in
        "" | "?" | None | null) return 1 ;;
        HEAD | HEAD-* | HEAD_*) return 1 ;;
        *) return 0 ;;
    esac
}

# Print up to 5 CVE detail lines ("    [SEV] CVE-ID (CVSS n.n) — source") from
# a scanner JSON verdict ($1). Shared by the security-check loop and the
# age-check CVE bypass (#72), so every "has CVEs" verdict names the CVEs the
# user is being asked to act on.
#
# A finding carrying no version scope is marked as such, and a trailing note
# counts them. This matters most under a freshness hold: the hold scans the
# INSTALLED version, which is never the latest, so partition_unactionable()
# leaves its unscoped findings in "vulnerabilities" (still blocking, fail-closed)
# rather than demoting them to "unactionable". Rendered bare, they read as
# actionable — and then "does not demonstrably fix them" reads as a
# contradiction, when it is in fact the direct consequence of their being
# unscoped. Presentation only: finding_ids() still folds both groups into the
# comparison, so no hold or bypass decision changes here.
print_vuln_lines() {
    echo "$1" | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    vulns = data.get('vulnerabilities', [])
    # Highest score first, id as tie-break. The scanner's order follows the
    # source's, and NVD's is not stable run to run: with more than five CVEs a
    # different five showed each time, so a vanished id read as 'fixed'.
    vulns = sorted(vulns, key=lambda v: (-(v.get('score') or 0), v.get('id', '')))
    for v in vulns[:5]:
        sev = v.get('severity', '?')
        vid = v.get('id', '?')
        score = v.get('score') or 0  # a null score must not erase the whole list
        src = v.get('source', '?')
        score_str = f' (CVSS {score})' if score > 0 else ''
        # Mark ONLY an explicit False. An absent key means the source has no
        # concept of CPE scoping (OSV, the GitHub Advisory Database) — not that
        # the finding is unscoped — and marking those would mark nearly
        # everything, which marks nothing.
        scope_str = ' (no version scope)' if v.get('scoped') is False else ''
        print(f'    [{sev}] {vid}{score_str} — {src}{scope_str}')
    if len(vulns) > 5:
        print(f'    … and {len(vulns) - 5} more ({len(vulns)} total)')
    # Counted over ALL findings, not the five displayed: the caller most in need
    # of this line is a freshness hold, whose list is usually truncated.
    unscoped = sum(1 for v in vulns if v.get('scoped') is False)
    if unscoped:
        # NOT the 'note:' prefix — that one belongs to print_scan_notes and
        # relays the SCANNER's own words. When resolve_latest_version() fails,
        # the scanner emits its own unscoped-findings note with a different
        # count of the same set, and two 'note:' lines disagreeing about one set
        # is worse than no line at all.
        print(f'    why: {unscoped} of {len(vulns)} finding(s) carry no version '
              'scope — nothing ties them to a particular version, so no upgrade '
              'can be shown to fix them.')
except Exception:
    pass
" 2>/dev/null || true
}

# Print the scanner's coverage notes from a verdict ($1) under the package's
# line ("    note: …"). The scanner runs with 2>/dev/null here, so anything it
# only said on stderr — "N unanalysed records … relying on CPE-analysed
# records only" — never reached the user; the JSON carries them as "notes".
print_scan_notes() {
    echo "$1" | python3 -c "
import sys, json
try:
    for n in json.load(sys.stdin).get('notes') or []:
        print(f'    note: {n}')
except Exception:
    pass
" 2>/dev/null || true
}

# Sorted, de-duplicated finding ids from a scanner verdict ($1), one per line.
# Used to compare the candidate's exposure with the installed version's.
finding_ids() {
    echo "$1" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    # Both arrays. A finding declared UNACTIONABLE is not fixed — it is simply
    # not a reason to block, and it applies to the installed version too. Reading
    # only 'vulnerabilities' made the candidate look like it had fixed it, so
    # [IMPROVES] claimed a security improvement that never happened.
    vulns = (d.get('vulnerabilities') or []) + (d.get('unactionable') or [])
    ids = sorted({str(v.get('id', '')) for v in vulns if v.get('id')})
    print('\\n'.join(ids))
except Exception:
    pass
" 2>/dev/null || true
}

# Findings the CANDIDATE ($1) carries that the INSTALLED version ($2) does not.
# Empty output means the upgrade introduces nothing new: its exposure is a
# subset of what is already on the machine, so blocking it can only keep the
# user on the more vulnerable version. Both inputs come from finding_ids (sorted,
# unique); re-sorting is cheap and keeps comm's precondition local.
# Finding ids from a scan, but only when the scan can be TRUSTED as a finding
# set. Prints the ids and returns 0; prints nothing and returns 1 when the
# result is not a usable answer, so a caller can tell "nothing found" apart from
# "nothing came back".
#
#   exit 0  — scanned, no blocking vulns. Still parsed: a package whose only
#             findings are UNACTIONABLE exits 0 and those ids must be compared,
#             which is the whole hugo case.
#   exit 1  — findings reported. Trustworthy ONLY if ids actually parse: the
#             scanner also exits 1 with EMPTY stdout when it dies before
#             json.dump (see the `or 0` note in dependency_security_check.py,
#             which shipped exactly that bug once). Empty here means "crashed",
#             never "clean" — and reading it as clean makes a candidate look
#             like it fixed everything.
#   exit 2+ — no source could answer. Not an answer.
trusted_finding_ids() { # $1 = json, $2 = exit code
    local _json="$1" _exit="$2" _ids
    case "$_exit" in
        0 | 1) ;;
        *) return 1 ;;
    esac
    _ids=$(finding_ids "$_json")
    if [ "$_exit" -eq 1 ] && [ -z "$_ids" ]; then
        return 1
    fi
    printf '%s\n' "$_ids"
    return 0
}

# How many of the applicable vulnerability sources actually answered.
# Comparing two scans is only meaningful when the second looked at least as hard
# as the first: a candidate scanned with fewer sources reporting will naturally
# show fewer findings, which is indistinguishable from a fix.
#
# For the `brew` ecosystem this is currently always 1 or 0 — NVD is the only
# applicable source, so a failure means sources_ok 0, which already exits 2 and
# is rejected above. The guard is here so that adding an OSV/GHSA Homebrew
# mapping later cannot silently turn partial coverage into a phantom reduction.
scan_sources_ok() { # $1 = json; prints an integer (0 when unreadable)
    echo "$1" | python3 -c "
import sys, json
try:
    print(int(json.load(sys.stdin).get('sources_ok', 0) or 0))
except Exception:
    print(0)
" 2>/dev/null || echo 0
}

new_findings() {
    comm -23 \
        <(printf '%s\n' "$1" | grep -v '^$' | sort -u) \
        <(printf '%s\n' "$2" | grep -v '^$' | sort -u)
}

# Elapsed-time reporter: phase_took <label> <start_seconds>. Uses bash's SECONDS
# so a 10-minute run shows where the time went — the age phase, the security
# phase and the dependency phase have very different cost profiles and the
# output gave no way to tell them apart.
phase_took() {
    echo "  ($1 took $((SECONDS - $2))s)"
}

# First failure reason from a scanner verdict ($1), or nothing. Lets the [skip]
# line say WHICH failure — a 404, a truncated read, a throttle and a
# 1,000-record overflow used to print identically as \"check failed\".
first_failure_reason() {
    echo "$1" | python3 -c "
import sys, json
try:
    r = json.load(sys.stdin).get('failure_reasons') or []
    print(r[0][:120] if r else '')
except Exception:
    print('')
" 2>/dev/null || true
}

# --- Guarded self-upgrade (--self, issue #87) --------------------------------
# `brew upgrade safe-upgrade` pulls safe-upgrade's OWN outdated dependencies
# (python@3.12 -> openssl@3, sqlite, ...) with none of the CVE / SHA / freshness
# gates this tool applies. --self closes that gap: gate safe-upgrade's outdated
# deps through the normal path FIRST (fail-closed), confirm none is left
# outdated, and only then upgrade the formula — so brew has nothing ungated left
# to pull. Homebrew formula install only; the script install uses brew safe-update.
enumerate_outdated_self_deps() {
    # Print safe-upgrade's currently-outdated brew dependencies, one per line.
    # `brew deps` returns the FULL transitive closure by default, so intersecting
    # it with `brew outdated` covers the whole chain, not just direct deps.
    #
    # FAIL CLOSED: any brew/JSON failure returns non-zero so callers ABORT — an
    # error must never be mistaken for "nothing outdated" and wave the formula
    # upgrade through ungated (that is the exact #87 gap). An empty result WITH a
    # zero exit means there genuinely are no outdated deps. (`brew outdated` /
    # `brew deps` exit 0 on success even when packages are outdated; they return
    # non-zero only on a real error such as an unresolvable formula.)
    local deps_list outdated_json
    if ! deps_list="$(brew deps "$SELF_FORMULA" 2>/dev/null)"; then
        echo "Error: could not enumerate $SELF_FORMULA dependencies (brew deps failed)." >&2
        return 1
    fi
    if ! outdated_json="$(brew outdated --json=v2 2>/dev/null)"; then
        echo "Error: could not list outdated formulae (brew outdated failed)." >&2
        return 1
    fi
    DEPS_LIST="$deps_list" OUTDATED_JSON="$outdated_json" python3 -c '
import os, json, sys
deps = [d.strip() for d in os.environ.get("DEPS_LIST", "").splitlines() if d.strip()]
try:
    data = json.loads(os.environ.get("OUTDATED_JSON") or "{}")
except Exception as exc:
    sys.stderr.write("Error: invalid brew outdated JSON: %s\n" % exc)
    sys.exit(1)
outdated = {p.get("name", "") for p in data.get("formulae", []) if p.get("name")}
# Exact canonical-name match. The safe-upgrade dependency closure is entirely
# homebrew-core (bare names like openssl@3), and brew outdated reports core
# formulae by the same bare name, so the names align exactly. Matching on the
# basename instead would let an UNRELATED outdated tap formula that merely shares
# a basename (e.g. evil/tap/openssl@3) masquerade as our dependency.
seen = set()
for d in deps:
    if d in outdated and d not in seen:
        seen.add(d)
        print(d)
'
}

upgrade_self_through_gate() {
    case "$SCRIPT_DIR" in
        */libexec | */libexec/* | */Cellar/*) ;; # Homebrew formula route — proceed.
        *)
            echo "Script-install route detected — --self applies to the Homebrew formula install."
            echo "To update the script install, run: brew safe-update"
            exit 1
            ;;
    esac

    echo "Self-upgrade: gating $SELF_FORMULA's dependencies before the formula..."
    # Fail closed if `brew update` fails: this path decides what to gate from the
    # current dependency graph, and the final formula upgrade must not run against
    # stale metadata. (The normal flow tolerates this; --self is deliberately
    # stricter — it is about to upgrade the security tool itself.)
    if ! run_brew_update; then
        echo "Error: 'brew update' failed — safe-upgrade was NOT upgraded (fail-closed)."
        exit 1
    fi

    # Fail closed if enumeration itself errors (brew/JSON failure): never treat an
    # enumeration error as "nothing outdated" and let the formula upgrade proceed.
    local outdated_deps
    if ! outdated_deps="$(enumerate_outdated_self_deps)"; then
        echo "safe-upgrade was NOT upgraded (fail-closed)."
        exit 1
    fi

    if [ -n "$outdated_deps" ]; then
        echo "Gating outdated dependencies: $(printf '%s' "$outdated_deps" | tr '\n' ' ')"

        # Thread ONLY the policy flags the user set into the gated dep run. --self
        # is deliberately NOT passed, so the child runs the normal path (no
        # recursion). The child upgrades the deps through the full gate; a held or
        # blocked dep is simply left un-upgraded (caught by the re-check below).
        local child_args=()
        [ "$AUTO_YES" = true ] && child_args+=("--yes")
        [ "$MIN_AGE" != "3" ] && child_args+=("--min-age" "$MIN_AGE")
        [ "$ALLOW_UNKNOWN_AGE" = true ] && child_args+=("--allow-unknown-age")
        [ "$VERIFY_SHA" = false ] && child_args+=("--no-verify-sha")
        [ "$CHECK_DEPS" = false ] && child_args+=("--no-deps")
        while IFS= read -r _dep; do
            [ -n "$_dep" ] && child_args+=("$_dep")
        done <<<"$outdated_deps"

        if ! "$0" ${child_args[@]+"${child_args[@]}"}; then
            echo ""
            echo "Dependency gate failed — safe-upgrade was NOT upgraded (fail-closed)."
            exit 1
        fi
    else
        echo "No outdated dependencies — safe-upgrade can be upgraded directly."
    fi

    # Belt-and-suspenders — the PRIMARY gate. A held or blocked dependency does
    # not necessarily make the gated run exit non-zero (it is merely EXCLUDED from
    # the upgrade), so re-verify that nothing in the chain is still outdated before
    # the formula upgrade lets brew pull it ungated. Any survivor aborts fail-closed.
    local still_outdated
    if ! still_outdated="$(enumerate_outdated_self_deps)"; then
        echo "safe-upgrade was NOT upgraded (fail-closed)."
        exit 1
    fi
    if [ -n "$still_outdated" ]; then
        echo ""
        echo "These dependencies are still outdated after the gate (held or blocked):"
        printf '%s\n' "$still_outdated" | sed 's/^/  /'
        echo "safe-upgrade was NOT upgraded (fail-closed)."
        exit 1
    fi

    echo ""
    echo "Upgrading $SELF_FORMULA (dependencies verified clean)..."
    # HOMEBREW_NO_AUTO_UPDATE=1: without it, this raw `brew upgrade` can trigger
    # Homebrew's implicit auto-update, which re-refreshes metadata and could pull a
    # newly-outdated dependency UNGATED between the belt-and-suspenders re-check
    # above and this upgrade (a TOCTOU gap). We already ran `brew update` and
    # verified the graph; pin it here so nothing new slips in.
    if ! HOMEBREW_NO_AUTO_UPDATE=1 brew upgrade --formula "$SELF_FORMULA" </dev/null 2>&1; then
        echo "Error: 'brew upgrade --formula $SELF_FORMULA' failed."
        exit 1
    fi
    echo ""
    echo "Done — safe-upgrade updated through its own gate."
    exit 0
}

if [ "$SELF_UPGRADE_MODE" = true ]; then
    upgrade_self_through_gate
fi

echo "Updating Homebrew..."
run_brew_update || true

echo "Checking for outdated packages..."
OUTDATED_JSON=$(brew outdated --json=v2 2>/dev/null || echo '{"formulae":[],"casks":[]}')

# Parse formulae
#
# installed_versions[-1], not [0]. brew builds that list in outdated_kegs() as
# `all_kegs.sort_by(&:scheme_and_version)` (Homebrew's formula.rb) — ASCENDING,
# by brew's own version ordering, which ranks revisions (10.47 < 10.47_1) in a
# way our PEP 440 comparator deliberately does not. So the LAST entry is the keg
# brew will upgrade FROM, and the only correct baseline for the relative verdict.
#
# Taking [0] read the OLDEST keg. Two kegs in the Cellar is not exotic — any
# skipped or failed cleanup leaves one — and the consequence was fail-OPEN: a
# stale keg carries more CVEs, so "installed has CVEs" fired and waved the
# candidate past the freshness hold on the strength of a version the user is not
# running. Seen live: simdjson reported as installed 4.6.4 while brew upgraded
# from 4.6.7, bypassing the 3-day hold for a release published that same day.
# The dependency path already took the last version (`awk '$NF'`); this brings
# the top-level path in line.
#
# `or ['?']` rather than a dict default: the key can be present AND an empty
# list, which made [0] raise IndexError. That was caught by the blanket
# `except` below, which discards the WHOLE list — every outdated package gone,
# "Everything up to date.", exit 0. Fail-open again, from one odd entry.
OUTDATED_FORMULAE=$(echo "$OUTDATED_JSON" | python3 -c "
import sys, json

def installed_of(entry):
    vs = entry.get('installed_versions') or []
    # Drop HEAD kegs before taking the last one. brew appends a HEAD keg to
    # all_kegs BEFORE its own \`next if version.head?\` (formula.rb), and
    # Version#<=> ranks HEAD above every numbered version, so HEAD sorts LAST
    # and [-1] would return 'HEAD-9f3a1'. parse_version() cannot read that, and
    # version_in_range() answers 'affected' for anything it cannot parse — so
    # the baseline would come back carrying every CVE in the database, firing
    # the freshness bypass and reducing every real regression to [SAME]. That is
    # the same fail-open as the '?' sentinel, reached by a different spelling.
    # A rack holding only HEAD kegs has no usable baseline and yields '?', which
    # installed_version_known() rejects.
    #
    # Falsy entries are dropped in the same pass: a cask's installed_version can
    # be the empty string, and an empty field would collapse this line's three
    # space-separated columns down to two — \`read name installed current\` then
    # slides current into installed and leaves current empty.
    real = [str(v) for v in vs if v and not str(v).startswith('HEAD')]
    return real[-1] if real else '?'

try:
    data = json.load(sys.stdin)
    for p in data.get('formulae', []):
        name = p.get('name', '')
        installed = installed_of(p)
        current = p.get('current_version', '?')
        print(f'{name} {installed} {current}')
except Exception:
    pass
" 2>/dev/null)

# Parse casks (same JSON keys as formulae: name, installed_versions, current_version)
#
# brew only ever puts one entry in a cask's installed_versions (Cask#outdated_info
# builds it as `[installed_version]`), so [-1] and [0] agree today. It is written
# the same way as the formula path above on purpose: identical shape, one rule to
# remember, and no second fail-open to find if brew ever lists cask kegs too.
OUTDATED_CASKS=$(echo "$OUTDATED_JSON" | python3 -c "
import sys, json

def installed_of(entry):
    # Same rules as the formula parser above — see the comment there. A cask's
    # installed_version is built as \`outdated_version(...).to_s\`, which is the
    # empty string when that resolves to nil, so the falsy filter is load-bearing
    # on this path in particular.
    vs = entry.get('installed_versions') or []
    real = [str(v) for v in vs if v and not str(v).startswith('HEAD')]
    return real[-1] if real else '?'

try:
    data = json.load(sys.stdin)
    for c in data.get('casks', []):
        name = c.get('name', '')
        installed = installed_of(c)
        current = str(c.get('current_version', '?'))
        # Strip SHA suffix from cask versions (e.g. '1.2.3,abc123' -> '1.2.3')
        if ',' in current:
            current = current.split(',')[0]
        if ',' in str(installed):
            installed = str(installed).split(',')[0]
        print(f'{name} {installed} {current}')
except Exception:
    pass
" 2>/dev/null)

# --- Single-package mode (#61) -------------------------------------------------
# If package name(s) were given as positional args, restrict this run to just
# those. Matches the full outdated name OR its basename, so
# `brew safe-upgrade safe-fetch` matches `sharkyger/tap/safe-fetch`.
TARGET_PKGS=$(echo "$TARGET_PKGS" | xargs) # trim
if [ -n "$TARGET_PKGS" ]; then
    _keep_targeted() {
        awk -v targets="$TARGET_PKGS" '
            BEGIN { n = split(targets, t, " "); for (i = 1; i <= n; i++) want[t[i]] = 1 }
            NF { bn = $1; sub(/.*\//, "", bn); if ($1 in want || bn in want) print }
        '
    }
    OUTDATED_FORMULAE=$(printf '%s\n' "$OUTDATED_FORMULAE" | _keep_targeted)
    OUTDATED_CASKS=$(printf '%s\n' "$OUTDATED_CASKS" | _keep_targeted)

    # Note any named package that isn't actually outdated, so the user isn't left
    # wondering why it was a no-op.
    for _tp in $TARGET_PKGS; do
        if ! printf '%s\n%s\n' "$OUTDATED_FORMULAE" "$OUTDATED_CASKS" |
            awk -v want="$_tp" 'NF { bn = $1; sub(/.*\//, "", bn); if ($1 == want || bn == want) f = 1 } END { exit !f }'; then
            echo "  $_tp — not outdated (already up to date, or not an installed/known package)"
        fi
    done
fi

if [ -z "$OUTDATED_FORMULAE" ] && [ -z "$OUTDATED_CASKS" ]; then
    if [ -n "$TARGET_PKGS" ]; then
        echo "Nothing to upgrade for: $TARGET_PKGS"
    else
        echo "Everything up to date."
    fi
    exit 0
fi

FORMULA_COUNT=0
CASK_COUNT=0
[ -n "$OUTDATED_FORMULAE" ] && FORMULA_COUNT=$(echo "$OUTDATED_FORMULAE" | wc -l | tr -d ' ')
[ -n "$OUTDATED_CASKS" ] && CASK_COUNT=$(echo "$OUTDATED_CASKS" | wc -l | tr -d ' ')
TOTAL_COUNT=$((FORMULA_COUNT + CASK_COUNT))

echo ""
echo "Found $TOTAL_COUNT outdated package(s) ($FORMULA_COUNT formulae, $CASK_COUNT casks):"
echo ""
printf "  %-30s %-15s %-15s %s\n" "Package" "Type" "Installed" "Available"
printf "  %-30s %-15s %-15s %s\n" "-------" "----" "---------" "---------"
if [ -n "$OUTDATED_FORMULAE" ]; then
    echo "$OUTDATED_FORMULAE" | while read -r name installed current; do
        printf "  %-30s %-15s %-15s -> %s\n" "$name" "formula" "$installed" "$current"
    done
fi
if [ -n "$OUTDATED_CASKS" ]; then
    echo "$OUTDATED_CASKS" | while read -r name installed current; do
        printf "  %-30s %-15s %-15s -> %s\n" "$name" "cask" "$installed" "$current"
    done
fi

# Combine for security checking
OUTDATED=""
[ -n "$OUTDATED_FORMULAE" ] && OUTDATED="$OUTDATED_FORMULAE"
if [ -n "$OUTDATED_CASKS" ]; then
    [ -n "$OUTDATED" ] && OUTDATED="$OUTDATED"$'\n'"$OUTDATED_CASKS" || OUTDATED="$OUTDATED_CASKS"
fi

# --- Min-age check (default: 3 days; --min-age 0 to disable) ---
HELD_PKGS=""
HELD_COUNT=0

if [ "$MIN_AGE" -gt 0 ] 2>/dev/null; then
    echo ""
    echo "Checking package age (min-age: $MIN_AGE days)..."
    echo ""
    _phase_start=$SECONDS

    FILTERED_OUTDATED=""
    while read -r name installed current; do
        # Defense in depth: only allow Homebrew-shaped names through the URL.
        if [[ ! "$name" =~ ^[a-zA-Z0-9@._/-]+$ ]]; then
            echo "  [skip] $name -- invalid name, refusing to query"
            FILTERED_OUTDATED="${FILTERED_OUTDATED}${name} ${installed} ${current}"$'\n'
            continue
        fi

        # Route the age lookup to the right repo: a slash means a tap formula;
        # membership in the cask list means a cask; otherwise a core formula.
        # (Casks and taps used to be queried against homebrew-core, always missed,
        # and were waved through as "age unknown" — the fail-open this fixes.)
        PKG_TYPE_AGE="core"
        case "$name" in
            */*) PKG_TYPE_AGE="tap" ;;
            *)
                if printf '%s\n' "$OUTDATED_CASKS" | awk -v n="$name" 'NF && $1==n{f=1} END{exit !f}'; then
                    PKG_TYPE_AGE="cask"
                fi
                ;;
        esac

        AGE_INFO=$(fetch_pkg_age "$name" "$PKG_TYPE_AGE" "$current")
        AGE_DAYS=$(echo "$AGE_INFO" | awk '{print $1}')
        PUB_DATE=$(echo "$AGE_INFO" | awk '{print $2}')

        if [ "$AGE_DAYS" = "-2" ]; then
            # GitHub API rate limit (issue #84). Distinct from "unknown age":
            # abort with the reset time unless the user opted into fail-open.
            if [ "$ALLOW_UNKNOWN_AGE" = true ]; then
                echo "  [ok] $name $current — GitHub API rate-limited, allowed by --allow-unknown-age"
                FILTERED_OUTDATED="${FILTERED_OUTDATED}${name} ${installed} ${current}"$'\n'
            else
                rate_limit_abort "$AGE_INFO"
            fi
        elif [ "$AGE_DAYS" -ge 0 ] 2>/dev/null && [ "$AGE_DAYS" -lt "$MIN_AGE" ]; then
            # Known and too fresh. The freshness hold is waived only for a
            # candidate that demonstrably REDUCES exposure — the same strict-subset
            # test the [IMPROVES] verdict uses, and for the same reason
            # finding_ids() folds `unactionable` into the comparison: a finding NVD
            # could not tie to a version is not fixed by the upgrade, it is merely
            # not grounds to block, and it applies to both sides equally.
            #
            # "Installed has CVEs" alone was the old trigger, and it fired on mere
            # exposure. Live 2026-09-10: hugo, nss and snyk each waived the hold on
            # findings the candidate carried identically — hugo's four, including a
            # CRITICAL, are no-version-scope on 0.166.0 too — so a one-day-old
            # release skipped the supply-chain hold and bought no known reduction.
            # Only vscodium earned it, fixing 13 of 14. Three of four were
            # unjustified. The block decision was made relative in v0.3.5; this is
            # the bypass decision catching up.
            #
            # Costs one extra scan, only for a package that is BOTH too fresh AND
            # carries findings on the installed side — four packages in that run.
            # No known installed version, or an unreadable candidate scan, leaves
            # no evidence of reduction, so the hold stands (fail closed).
            INSTALLED_EXIT=0
            _INSTALLED_RESULT=""
            if installed_version_known "$installed"; then
                _INSTALLED_RESULT=$(python3 "$SCRIPT" brew "$name" "$installed" 2>/dev/null) && INSTALLED_EXIT=0 || INSTALLED_EXIT=$?
            fi

            _BYPASS_OK=false
            _BYPASS_FIXED=0
            _n_inst=0
            # Why the bypass was not granted, so the hold line states what was
            # actually determined instead of asserting a comparison that never
            # ran: "compared" (no reduction) vs "unreadable" (could not compare).
            _BYPASS_WHY=""
            if [ "$INSTALLED_EXIT" -eq 1 ]; then
                if _AGE_INST_IDS=$(trusted_finding_ids "$_INSTALLED_RESULT" "$INSTALLED_EXIT"); then
                    _AGE_CAND_EXIT=0
                    _AGE_CAND_RESULT=$(python3 "$SCRIPT" brew "$name" "$current" 2>/dev/null) || _AGE_CAND_EXIT=$?
                    if _AGE_CAND_IDS=$(trusted_finding_ids "$_AGE_CAND_RESULT" "$_AGE_CAND_EXIT"); then
                        _inst_srcs=$(scan_sources_ok "$_INSTALLED_RESULT")
                        _cand_srcs=$(scan_sources_ok "$_AGE_CAND_RESULT")
                        if [ "$_cand_srcs" -lt "$_inst_srcs" ]; then
                            # Fewer databases answered for the candidate, so
                            # "fewer findings" is not evidence of a fix.
                            _BYPASS_WHY="unreadable"
                        else
                            _AGE_NEW_IDS=$(new_findings "$_AGE_CAND_IDS" "$_AGE_INST_IDS")
                            _n_inst=$(printf '%s\n' "$_AGE_INST_IDS" | grep -c .)
                            _n_cand=$(printf '%s\n' "$_AGE_CAND_IDS" | grep -c .)
                            # Strict improvement: adds nothing, drops at least one.
                            if [ -z "$_AGE_NEW_IDS" ] && [ "$_n_cand" -lt "$_n_inst" ]; then
                                _BYPASS_OK=true
                                _BYPASS_FIXED=$((_n_inst - _n_cand))
                            else
                                _BYPASS_WHY="compared"
                            fi
                        fi
                    else
                        _BYPASS_WHY="unreadable"
                    fi
                else
                    _BYPASS_WHY="unreadable"
                fi
            fi

            if [ "$_BYPASS_OK" = true ]; then
                echo "  [ok] $name $current — released $AGE_DAYS day(s) ago ($PUB_DATE), fixes $_BYPASS_FIXED of $_n_inst finding(s) from installed $installed and adds none — bypassing age check"
                # Name the CVEs (#72) so the decision rests on data, not on a
                # bare "CVE! update!" note.
                print_vuln_lines "$_INSTALLED_RESULT"
                FILTERED_OUTDATED="${FILTERED_OUTDATED}${name} ${installed} ${current}"$'\n'
            elif [ "$_BYPASS_WHY" = "compared" ]; then
                # Exposed, and the candidate was scanned, but it is not evidence
                # of a fix. Say that plainly — the old line announced a bypass as
                # if it were earned.
                echo "  [HOLD] $name $current — released $AGE_DAYS day(s) ago ($PUB_DATE), min-age: $MIN_AGE days; installed $installed has findings but $current does not demonstrably fix them (--min-age 0 overrides)"
                # Same #72 contract as the bypass line above: the user is being
                # asked to weigh a manual --min-age 0 override, so name what they
                # are exposed to. Omitting it here read as "your CVEs went
                # unnoticed" precisely where the detail mattered most.
                print_vuln_lines "$_INSTALLED_RESULT"
                HELD_PKGS="$HELD_PKGS $name"
                HELD_COUNT=$((HELD_COUNT + 1))
            elif [ "$_BYPASS_WHY" = "unreadable" ]; then
                # Never claim "does not fix them" here: no comparison happened.
                # The fix is different too — retry, or set an NVD API key.
                echo "  [HOLD] $name $current — released $AGE_DAYS day(s) ago ($PUB_DATE), min-age: $MIN_AGE days; installed $installed has findings but $current could not be checked to compare (--min-age 0 overrides)"
                print_vuln_lines "$_INSTALLED_RESULT"
                HELD_PKGS="$HELD_PKGS $name"
                HELD_COUNT=$((HELD_COUNT + 1))
            else
                echo "  [HOLD] $name $current — released $AGE_DAYS day(s) ago ($PUB_DATE), min-age: $MIN_AGE days"
                HELD_PKGS="$HELD_PKGS $name"
                HELD_COUNT=$((HELD_COUNT + 1))
            fi
        elif [ "$AGE_DAYS" -ge 0 ] 2>/dev/null; then
            # Known and old enough — clear the freshness hold.
            echo "  [ok] $name $current — released $AGE_DAYS day(s) ago ($PUB_DATE)"
            FILTERED_OUTDATED="${FILTERED_OUTDATED}${name} ${installed} ${current}"$'\n'
        else
            # Age could not be verified. FAIL CLOSED: hold unless explicitly
            # overridden. (Was: "[ok] … age unknown, skipping age check" — a
            # fail-open that allowed 0-day casks/taps straight through.)
            if [ "$ALLOW_UNKNOWN_AGE" = true ]; then
                echo "  [ok] $name $current — age could not be verified, allowed by --allow-unknown-age"
                FILTERED_OUTDATED="${FILTERED_OUTDATED}${name} ${installed} ${current}"$'\n'
            else
                echo "  [HOLD] $name $current — age could not be verified (min-age: $MIN_AGE days); re-run with --allow-unknown-age to override"
                HELD_PKGS="$HELD_PKGS $name"
                HELD_COUNT=$((HELD_COUNT + 1))
            fi
        fi
    done <<<"$OUTDATED"
    phase_took "age check" "$_phase_start"

    # Replace OUTDATED with filtered list (remove trailing newline)
    OUTDATED=$(echo "$FILTERED_OUTDATED" | sed '/^$/d')

    if [ -z "$OUTDATED" ]; then
        echo ""
        echo "All packages held due to min-age policy."
        if [ -n "$HELD_PKGS" ]; then
            echo "  Held (too fresh):$HELD_PKGS"
        fi
        echo ""
        echo "Done."
        exit 0
    fi
fi

echo ""
echo "Running security checks..."
echo ""
_phase_start=$SECONDS

BLOCKED_PKGS=""
SAME_PKGS=""
IMPROVED_PKGS=""
TAMPERED_PKGS=""
# Packages the gate cleared that brew then declined to upgrade. Initialised here
# because the final exit check reads it on every path, including the ones that
# never reach the upgrade block (nothing clean, user answered "n").
UPGRADE_FAILED_PKGS=""
# Set when the post-upgrade verification could not be performed at all.
UPGRADE_UNVERIFIED=""

# One actionable note per run when NVD threw us out for asking too fast.
# The scanner is invoked with 2>/dev/null, so its stderr hint never reaches the
# user here — the signal travels in the JSON on stdout instead. Without this a
# throttled run just shows packages being held for no stated reason, which reads
# as the tool being broken and pushes people toward --no-deps.
RATE_LIMIT_SEEN=false
RATE_LIMIT_NOTED=false
note_rate_limit() {
    [ "$RATE_LIMIT_SEEN" = true ] || return 0
    # Trim before deciding, matching the scanner's .strip(). They must agree:
    # the scanner sends no apiKey header for a whitespace-only value, so the run
    # IS throttled — and a wrapper that read the same value as "key present"
    # would suppress the explanation in exactly the case the user most needs it,
    # because they believe they have a working key.
    # Both spellings, matching _nvd_api_key() in the scanner. Only the
    # HOMEBREW_-prefixed one survives `brew`'s env scrub, so reading just
    # NVD_API_KEY here would print "no key configured" at a user whose key is
    # in fact working — the same wrapper/scanner disagreement, inverted.
    _nvd_key="${NVD_API_KEY:-}${HOMEBREW_NVD_API_KEY:-}"
    _nvd_key="${_nvd_key//[[:space:]]/}"
    [ -n "$_nvd_key" ] && return 0
    # At most once per run. There is a call site after the top-level skip
    # summary and another after the dependency one, and a throttle severe
    # enough to hit packages usually hits deps too — so both fire and the user
    # reads the same paragraph twice.
    [ "$RATE_LIMIT_NOTED" = true ] && return 0
    RATE_LIMIT_NOTED=true
    echo ""
    echo "  Note: NIST NVD rate-limited this run (5 requests / 30s without a key)."
    echo "        Packages above were HELD because nothing could vet them, not because"
    echo "        they are known-bad. Set HOMEBREW_NVD_API_KEY (NVD_API_KEY works"
    echo "        outside \`brew\`, which scrubs it) for 50/30s — free, no wait:"
    echo "        https://nvd.nist.gov/developers/request-an-api-key"
}
SKIPPED_PKGS=""
CLEAN_COUNT=0
SHA_API_ERROR_PKGS=""

while read -r name installed current; do
    if [ -f "$SCRIPT" ]; then
        # Capture stdout (JSON) and stderr separately
        RESULT_JSON=$(python3 "$SCRIPT" brew "$name" "$current" 2>/dev/null) && EXIT_CODE=0 || EXIT_CODE=$?

        if [ "$EXIT_CODE" -eq 0 ]; then
            # --- SHA verification (default ON; --no-verify-sha to opt out) ---
            # See brew-safe-install for the full contract; this block must stay symmetric.
            # Passing-path [sha] detail lines are BUFFERED in SHA_DETAIL and printed
            # under the package's verdict line, so per-package details never appear
            # above the package they belong to (#73). The [BLOCKED] mismatch block
            # still prints immediately — it IS the verdict and names the package.
            SHA_VERDICT="skip"
            SHA_DETAIL=""
            if [ "$VERIFY_SHA" = true ]; then
                # Determine type — upgrade lists formulae and casks together.
                PKG_INFO_JSON=$(brew info --json=v2 "$name" 2>/dev/null)
                PKG_TYPE_HERE=$(echo "$PKG_INFO_JSON" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    if d.get('casks'):
        print('cask')
    else:
        print('formula')
except Exception:
    print('formula')
" 2>/dev/null)

                if [ "$PKG_TYPE_HERE" = "cask" ]; then
                    SHA_DETAIL="    [sha] casks not in scope — brew enforces cask-file SHA at install"$'\n'
                    SHA_VERDICT="cask"
                else
                    # Resolved by the host's actual bottle tag (arch + macOS
                    # codename), not by dict-iteration order — see bottle_resolver.py.
                    LOCAL_SHA=$(echo "$PKG_INFO_JSON" | python3 "$BOTTLE_RESOLVER" --source local 2>/dev/null)

                    if [ -n "${MOCK_FORMULAE_API_DIR:-}" ]; then
                        MOCK_FILE="$MOCK_FORMULAE_API_DIR/${name}.json"
                        if [ ! -f "$MOCK_FILE" ]; then
                            SHA_HTTP_CODE=404
                            CANON_JSON=""
                        elif grep -q "__SIMULATE_API_ERROR__" "$MOCK_FILE"; then
                            SHA_HTTP_CODE=503
                            CANON_JSON=""
                        else
                            SHA_HTTP_CODE=200
                            CANON_JSON=$(cat "$MOCK_FILE")
                        fi
                    else
                        CANON_TMP=$(mktemp)
                        SHA_HTTP_CODE=$(curl -s -o "$CANON_TMP" -w "%{http_code}" --max-time 10 \
                            "https://formulae.brew.sh/api/formula/${name}.json" 2>/dev/null || echo "000")
                        CANON_JSON=$(cat "$CANON_TMP" 2>/dev/null || echo "")
                        rm -f "$CANON_TMP"
                    fi

                    # If the local tap has no bottle (built --from-source, or a tap
                    # that never ships bottles), there is nothing to compare against
                    # the canonical record — treat as no-bottle, not as tampering.
                    if [ -z "$LOCAL_SHA" ]; then
                        SHA_DETAIL="    [sha] no local bottle — built from source, skipping canonical check"$'\n'
                        SHA_VERDICT="no_bottle"
                        SHA_HTTP_CODE="SKIP"
                    fi

                    case "$SHA_HTTP_CODE" in
                        SKIP) : ;;
                        200)
                            CANON_SHA=$(echo "$CANON_JSON" | python3 "$BOTTLE_RESOLVER" --source canonical 2>/dev/null)
                            if [ "$CANON_SHA" = "NO_BOTTLE" ]; then
                                SHA_DETAIL="    [sha] no bottle — built from source"$'\n'
                                SHA_VERDICT="no_bottle"
                            elif [ "$CANON_SHA" = "PARSE_ERROR" ] || [ -z "$CANON_SHA" ]; then
                                SHA_API_ERROR_PKGS="$SHA_API_ERROR_PKGS $name"
                                SHA_VERDICT="api_error"
                            elif [ "$LOCAL_SHA" = "$CANON_SHA" ]; then
                                SHA_DETAIL="    [sha] verified ${LOCAL_SHA:0:16}=${CANON_SHA:0:16}"$'\n'
                                SHA_VERDICT="match"
                            else
                                echo "    [BLOCKED] SHA mismatch for $name"
                                echo "      local     : $LOCAL_SHA"
                                echo "      canonical : $CANON_SHA"
                                TAMPERED_PKGS="$TAMPERED_PKGS $name"
                                SHA_VERDICT="mismatch"
                            fi
                            ;;
                        404)
                            SHA_DETAIL="    [sha] tap-only formula — no canonical SHA available"$'\n'
                            SHA_VERDICT="tap_only"
                            ;;
                        *)
                            SHA_API_ERROR_PKGS="$SHA_API_ERROR_PKGS $name"
                            SHA_VERDICT="api_error"
                            ;;
                    esac
                fi
            fi

            if [ "$SHA_VERDICT" = "mismatch" ]; then
                : # [BLOCKED] already emitted; don't count as clean. --yes never overrides this.
            else
                echo "  [ok] $name $current"
                printf '%s' "$SHA_DETAIL"
                print_scan_notes "$RESULT_JSON"
                CLEAN_COUNT=$((CLEAN_COUNT + 1))
            fi
        elif [ "$EXIT_CODE" -eq 1 ]; then
            # Before blocking, compare with what is INSTALLED. A record with no
            # version scope (or a versionless CPE) hits the installed and the
            # candidate version identically, and then a block is a deadlock:
            # the age hold is waived because "installed has CVEs", the upgrade
            # is refused because "candidate has CVEs", and the package can
            # never pass — gh 2.98.0 sat on CVE-2024-53858 (fixed in 2.63.0,
            # never given a CPE) that way. Per-package CPE fixes cannot close
            # the class; the next unscoped record recreates it.
            #
            # Rule: block on what the candidate ADDS, never on what it removes.
            # If the candidate's findings are a SUBSET of the installed
            # version's, the upgrade cannot increase exposure — equal is [SAME],
            # strictly smaller is [IMPROVES] — and both upgrade with the clean
            # set. Anything the candidate carries and the installed version does
            # not, or an installed scan that fails, keeps the block (fail closed).
            #
            # Equality alone was the wrong test, and it failed in the unsafe
            # direction: python@3.12 3.12.14 fixed two of 3.12.13's eleven
            # findings and added none, and was blocked for it, holding the
            # machine on the MORE vulnerable version while the run exited 0.
            # Because Python's newest release essentially always carries open
            # CVEs, that was a permanent deadlock, not a transient hold.
            _CAND_IDS=$(finding_ids "$RESULT_JSON")
            # Same guard as the freshness bypass: an unknown installed version is
            # no baseline, and scanning "?" would return every CVE in the
            # database — turning the candidate's findings into a subset and
            # clearing it as [SAME]. Leaving _INST_IDS empty keeps the block.
            _INST_EXIT=0
            _INST_JSON=""
            if installed_version_known "$installed"; then
                _INST_JSON=$(python3 "$SCRIPT" brew "$name" "$installed" 2>/dev/null) && _INST_EXIT=0 || _INST_EXIT=$?
            fi
            _INST_IDS=""
            [ "$_INST_EXIT" -eq 1 ] && _INST_IDS=$(finding_ids "$_INST_JSON")
            _NEW_IDS=""
            if [ -n "$_CAND_IDS" ] && [ -n "$_INST_IDS" ]; then
                _NEW_IDS=$(new_findings "$_CAND_IDS" "$_INST_IDS")
            fi
            if [ -n "$_CAND_IDS" ] && [ -n "$_INST_IDS" ] && [ -z "$_NEW_IDS" ]; then
                _n=$(printf '%s\n' "$_CAND_IDS" | grep -c .)
                _ni=$(printf '%s\n' "$_INST_IDS" | grep -c .)
                if [ "$_n" -eq "$_ni" ]; then
                    echo "  [SAME] $name $current -- same $_n finding(s) as installed $installed, upgrade does not change exposure"
                    SAME_PKGS="$SAME_PKGS $name"
                else
                    echo "  [IMPROVES] $name $current -- fixes $((_ni - _n)) of $_ni finding(s) from installed $installed, introduces none"
                    IMPROVED_PKGS="$IMPROVED_PKGS $name"
                fi
                print_vuln_lines "$RESULT_JSON"
                print_scan_notes "$RESULT_JSON"
                CLEAN_COUNT=$((CLEAN_COUNT + 1))
            else
                echo "  [VULN] $name $current -- vulnerabilities found!"
                print_vuln_lines "$RESULT_JSON"
                print_scan_notes "$RESULT_JSON"
                BLOCKED_PKGS="$BLOCKED_PKGS $name"
            fi
        else
            _why=$(first_failure_reason "$RESULT_JSON")
            echo "  [skip] $name $current -- check failed${_why:+ ($_why)}, will not upgrade"
            print_scan_notes "$RESULT_JSON"
            SKIPPED_PKGS="$SKIPPED_PKGS $name"
            if echo "$RESULT_JSON" | grep -q '"rate_limited": *true'; then
                RATE_LIMIT_SEEN=true
            fi
        fi
    else
        echo "  Error: Security check script not found at $SCRIPT"
        echo "  A required helper (dependency_security_check.py) is missing from your install."
        echo "  Fix: run 'brew safe-update' to re-fetch all helpers (or re-run install.sh)."
        exit 2
    fi
done <<<"$OUTDATED"

# Build separate clean lists for formulae and casks. TAMPERED_PKGS is excluded
# alongside BLOCKED_PKGS so brew never sees a tampered formula on its cmdline.
EXCLUDE_PKGS="$BLOCKED_PKGS $TAMPERED_PKGS $SKIPPED_PKGS $HELD_PKGS"
CLEAN_PKGS_FORMULAE=""
CLEAN_PKGS_CASKS=""

# Membership by literal token (`case`), not `grep -qw` — the same correction the
# dependency path already carries a few hundred lines below, which the top-level
# build never received.
#
# `grep -qw "$name"` treated the package name as a BRE and matched on word
# boundaries, and Homebrew names are full of characters grep counts as
# boundaries: @ - + . So an excluded package silently suppressed every OTHER
# outdated package whose name was a word-component of it —
#
#     held  python@3.12  ->  also dropped  python
#     held  node@22      ->  also dropped  node
#     held  openssl@3    ->  also dropped  openssl
#
# and the suppressed package had already been printed as [ok] and counted in
# "Results: N clean". It then vanished: not upgraded, not listed as held, no
# line anywhere explaining it, exit 0. Versioned formulae are everywhere in
# Homebrew and a freshness hold on one is routine, so this was not a corner
# case. It fails closed (nothing unsafe is installed) but it is a silent
# correctness failure, and the post-upgrade verification cannot catch it —
# a suppressed package never enters CLEAN_PKGS, so it is never announced and
# never re-checked.
#
# `case` patterns match literally, so a package can only match itself.
#
# NOTE: this does NOT separate a formula from a cask of the same token — they
# genuinely share a name here, and untangling that needs type-tagged exclusion
# entries. Tracked in .codereview/exclude-pkgs-type-conflation.local.md.
_is_excluded() {
    case " $EXCLUDE_PKGS " in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

if [ -n "$OUTDATED_FORMULAE" ]; then
    while read -r name installed current; do
        if ! _is_excluded "$name"; then
            CLEAN_PKGS_FORMULAE="$CLEAN_PKGS_FORMULAE $name"
        fi
    done <<<"$OUTDATED_FORMULAE"
fi

if [ -n "$OUTDATED_CASKS" ]; then
    while read -r name installed current; do
        if ! _is_excluded "$name"; then
            CLEAN_PKGS_CASKS="$CLEAN_PKGS_CASKS $name"
        fi
    done <<<"$OUTDATED_CASKS"
fi

CLEAN_PKGS="${CLEAN_PKGS_FORMULAE}${CLEAN_PKGS_CASKS}"

# --- SHA batch error prompt (same shape as brew-safe-install) ---
if [ -n "$SHA_API_ERROR_PKGS" ]; then
    SHA_API_ERROR_PKGS_TRIMMED=$(echo "$SHA_API_ERROR_PKGS" | xargs)
    echo ""
    echo "[WARN] formulae.brew.sh unreachable for SHA verification: $SHA_API_ERROR_PKGS_TRIMMED"
    SHA_IS_INTERACTIVE=false
    if [ "${MOCK_INTERACTIVE_MODE:-0}" = "1" ] || [ -t 0 ]; then
        SHA_IS_INTERACTIVE=true
    fi
    # Under --yes we never prompt; we warn and continue. Same for non-TTY.
    if [ "$SHA_IS_INTERACTIVE" = true ] && [ "$AUTO_YES" != true ]; then
        # echo + read instead of read -rp — see brew-safe-install for rationale.
        echo "Install anyway? [y/N] "
        read -r SHA_CONFIRM
        if [[ ! "$SHA_CONFIRM" =~ ^[yY] ]]; then
            echo "Cancelled."
            exit 1
        fi
    else
        echo "[WARN] non-interactive or --yes — continuing without SHA verification for those packages"
    fi
fi

phase_took "security checks" "$_phase_start"

# Summary
echo ""
echo "Results: $CLEAN_COUNT clean"
if [ -n "$BLOCKED_PKGS" ]; then
    echo "  Blocked (vulnerable):$BLOCKED_PKGS"
fi
if [ -n "$SAME_PKGS" ]; then
    echo "  Unchanged exposure (same findings as installed, upgrading):$SAME_PKGS"
fi
if [ -n "$IMPROVED_PKGS" ]; then
    echo "  Reduced exposure (fixes findings, upgrading):$IMPROVED_PKGS"
fi
if [ -n "$TAMPERED_PKGS" ]; then
    echo "  Blocked (SHA tampered):$TAMPERED_PKGS"
fi
if [ -n "$HELD_PKGS" ]; then
    echo "  Held (too fresh):$HELD_PKGS"
fi
if [ -n "$SKIPPED_PKGS" ]; then
    echo "  Skipped (check failed):$SKIPPED_PKGS"
    note_rate_limit
fi

# --- Transitive dependency check (default on; --no-deps to skip) ---
#
# Design note: the CVE-aware bypass that skips --min-age for the user-named
# package when the installed version has known CVEs is intentionally NOT
# applied to transitive deps. Reasons: (1) the user explicitly opted into
# the named package, deps came along; (2) deps follow stricter rules so a
# fresh unverified dep can't ride in under cover of "the parent has CVEs";
# (3) running an installed-version CVE query for every dep would double
# rate-limited NVD traffic with little practical benefit. Held deps are
# surfaced via [HOLD-DEP]; user can override at the prompt.
#
# That reasoning covers the AGE bypass only. The CVE verdict itself IS
# relative here, as it is at the top level — see the [SAME-DEP]/[IMPROVES-DEP]
# branch below. Reason (3) does not carry over: that comparison runs only when
# a dep has already been flagged, so it costs one extra query per flagged dep,
# not one per dep.
#
# Storage: INCOMING_DEPS_ARR holds "<dep>|<incoming>|<installed>" entries
# (the third field is empty when the dep is not installed). `|` chosen because
# Homebrew formula names contain `@` (e.g. openssl@3) and versions occasionally
# do too — `|` cannot appear in either.
DEP_BLOCKED_VULN=""
DEP_BLOCKED_VULN_REASONS=""
DEP_BLOCKED_HOLD=""
DEP_BLOCKED_HOLD_REASONS=""
DEP_SKIPPED=""

# Defense in depth: only allow Homebrew-shaped names through any URL or
# subprocess argument we construct from `brew deps` output.
DEP_NAME_RE='^[a-zA-Z0-9@._/-]+$'

if [ "$CHECK_DEPS" = true ] && [ -n "$CLEAN_PKGS" ]; then
    echo ""
    echo "Checking transitive dependencies (deduped across batch)..."
    _phase_start=$SECONDS

    INCOMING_DEPS_ARR=()
    # "<dep>|<pkg>" ownership entries. INCOMING_DEPS_ARR is deduped across the
    # whole batch, which loses track of WHICH package pulled a dep in — and
    # without that we can only accept or reject the batch as a whole (#98).
    # `brew deps` is recursive by default, so this records the full closure.
    DEP_OWNERS_ARR=()

    # Graph walk, BATCHED. The first version ran `brew deps` per package and
    # then `brew info` + `brew list` per (package, dep) PAIR — closures overlap
    # heavily, so a 34-package batch made several hundred brew invocations
    # (each a Ruby start-up) to find two incoming deps: 378 s on the 2026-08-22
    # acceptance run, ~67x the cost of actually checking them. Now: one
    # `brew deps --for-each` for the whole batch, one `brew info` and one
    # `brew list` for the UNIQUE dep set, and the decision loop runs once per
    # unique dep. bash 3.2 has no associative arrays, so the lookups are
    # newline tables ("name value") read with awk. Each batched call falls
    # back to the per-item call if brew rejects the batch (one unknown name
    # fails the whole `brew info` invocation), so the result is the same set
    # the per-pair walk produced — only cheaper.
    _graph_start=$SECONDS
    # "<pkg> <dep>" lines, one per edge.
    DEP_EDGES=""
    # shellcheck disable=SC2086
    _for_each=$(brew deps --for-each $CLEAN_PKGS 2>/dev/null) || _for_each=""
    if [ -n "$_for_each" ]; then
        DEP_EDGES=$(printf '%s\n' "$_for_each" | awk -F': ' 'NF>=2 { n=split($2, d, " "); for (i=1;i<=n;i++) if (d[i] != "") print $1, d[i] }')
    else
        for pkg in $CLEAN_PKGS; do
            while IFS= read -r line; do
                [ -n "$line" ] && DEP_EDGES="${DEP_EDGES}${pkg} ${line}"$'\n'
            done < <(brew deps "$pkg" 2>/dev/null || true)
        done
    fi
    UNIQUE_DEPS=$(printf '%s\n' "$DEP_EDGES" | awk 'NF==2 {print $2}' | sort -u)

    # Name-validate BEFORE anything from the graph reaches a brew command line.
    QUERY_DEPS=""
    for dep in $UNIQUE_DEPS; do
        if [[ ! "$dep" =~ $DEP_NAME_RE ]]; then
            echo "    [skip-dep] $dep -- invalid name, refusing to query"
            continue
        fi
        QUERY_DEPS="$QUERY_DEPS $dep"
    done

    # "<name> <stable>" lines for every unique dep brew knows. Tap-qualified
    # names are keyed by full_name as well as name so either form resolves.
    DEP_LATEST_TABLE=""
    if [ -n "$QUERY_DEPS" ]; then
        # shellcheck disable=SC2086
        DEP_LATEST_TABLE=$(brew info --json=v2 --formula $QUERY_DEPS 2>/dev/null | python3 -c "
import sys, json
try:
    for f in json.load(sys.stdin).get('formulae', []):
        v = f.get('versions', {}).get('stable', '') or ''
        if not v:
            continue
        for key in {f.get('name', ''), f.get('full_name', '')}:
            if key:
                print(key, v)
except Exception:
    pass
" 2>/dev/null) || DEP_LATEST_TABLE=""
    fi
    # "<name> <installed>" lines. `brew list --versions a b c` prints NOTHING
    # and exits 1 if even one name is not installed — and incoming deps are
    # very often not installed — so the batch is built over the deps that
    # have a Cellar directory (one `brew --cellar`, then a stat per dep),
    # which is exactly the set brew can answer for. A dep without a Cellar
    # directory is not installed: INSTALLED_VER stays empty with no call at
    # all, the same verdict the per-dep `brew list` gave. Tap-qualified deps
    # live under their bare name in the Cellar and in brew's listing.
    # awk '$NF' takes the LAST version when several kegs are installed; the
    # revision suffix (_1, _2, …) is stripped so a revision bump of an
    # already-current formula isn't classified as incoming.
    DEP_INSTALLED_TABLE=""
    CELLAR=$(brew --cellar 2>/dev/null) || CELLAR=""
    INSTALLED_QUERY_DEPS=""
    if [ -n "$CELLAR" ]; then
        for dep in $QUERY_DEPS; do
            [ -d "$CELLAR/${dep##*/}" ] && INSTALLED_QUERY_DEPS="$INSTALLED_QUERY_DEPS $dep"
        done
    fi
    if [ -n "$INSTALLED_QUERY_DEPS" ]; then
        # shellcheck disable=SC2086
        DEP_INSTALLED_TABLE=$(brew list --versions --formula $INSTALLED_QUERY_DEPS 2>/dev/null | awk 'NF>=2 {print $1, $NF}' | sed 's/_[0-9]*$//') || DEP_INSTALLED_TABLE=""
    fi
    table_get() {
        # table_get <table> <key> → value of the first matching line
        printf '%s\n' "$1" | awk -v k="$2" '$1 == k { print $2; exit }'
    }

    for dep in $QUERY_DEPS; do
        LATEST=$(table_get "$DEP_LATEST_TABLE" "$dep")
        if [ -z "$LATEST" ]; then
            # Not in the batch answer (or the batch call failed): ask singly,
            # exactly as before, so one unresolvable name costs one call.
            LATEST=$(brew info --json=v2 --formula "$dep" 2>/dev/null | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    f = d.get('formulae', [])
    if f:
        print(f[0].get('versions', {}).get('stable', ''))
except Exception:
    pass
" 2>/dev/null)
        fi
        [ -z "$LATEST" ] && continue

        INSTALLED_VER=$(table_get "$DEP_INSTALLED_TABLE" "${dep##*/}")
        if [ -z "$INSTALLED_VER" ] && { [ -z "$CELLAR" ] || [ -d "$CELLAR/${dep##*/}" ]; }; then
            # Cellar unknown, or the dep IS installed but the batch did not
            # answer for it: ask singly, exactly as before.
            INSTALLED_VER=$(brew list --versions --formula "$dep" 2>/dev/null | awk '{print $NF}' | sed 's/_[0-9]*$//')
        fi

        # Skip if dep is already part of the upgrade batch (checked above).
        # Literal membership, not grep: DEP_NAME_RE admits '.', and as a
        # regex `foo.bar` also matches `fooXbar` — a dep wrongly read as
        # "in the batch" would skip its own check.
        case " $CLEAN_PKGS " in
            *" $dep "*) continue ;;
        esac

        if [ -z "$INSTALLED_VER" ] || [ "$INSTALLED_VER" != "$LATEST" ]; then
            # Third field is the INSTALLED version (empty when the dep is not
            # installed): the block path below needs a baseline to compare the
            # incoming findings against, and re-deriving it there would mean
            # another brew call per flagged dep.
            INCOMING_DEPS_ARR+=("${dep}|${LATEST}|${INSTALLED_VER}")
            # Ownership is recorded per (dep, pkg): two packages can share one
            # flagged dep and both have to be held.
            while IFS= read -r _owner; do
                [ -n "$_owner" ] && DEP_OWNERS_ARR+=("${dep}|${_owner}")
            done < <(printf '%s\n' "$DEP_EDGES" | awk -v d="$dep" '$2 == d { print $1 }' | sort -u)
        fi
    done
    phase_took "dependency graph" "$_graph_start"
    _phase_start=$SECONDS

    DEP_COUNT=${#INCOMING_DEPS_ARR[@]}

    if [ "$DEP_COUNT" -eq 0 ]; then
        echo "  No new dependency versions coming in."
    else
        echo "  Found $DEP_COUNT incoming dependency version(s) to check"
        echo ""

        _DEP_IDX=0
        for entry in ${INCOMING_DEPS_ARR[@]+"${INCOMING_DEPS_ARR[@]}"}; do
            DEP=${entry%%|*}
            _dep_rest=${entry#*|}
            DEP_VER=${_dep_rest%%|*}
            DEP_INSTALLED_VER=${_dep_rest#*|}

            # Progress (#60): each dep makes network calls (age + 3 CVE DBs), so a
            # large batch can run for minutes. Announce the dep BEFORE the slow
            # checks so the step isn't a silent wait.
            _DEP_IDX=$((_DEP_IDX + 1))
            echo "  [$_DEP_IDX/$DEP_COUNT] checking $DEP $DEP_VER..."

            if [ "$MIN_AGE" -gt 0 ] 2>/dev/null; then
                # Route by type: a slash means a tap formula (look it up in its own
                # tap repo), otherwise homebrew-core. Unknown age fails CLOSED
                # (HOLD-DEP) unless --allow-unknown-age — same policy as the
                # top-level check. (Previously tap deps were waved through with
                # [skip-dep-age], and a core dep whose age lookup came back empty
                # fell through to [ok-dep]: both fail-open paths now closed.)
                if [[ "$DEP" == */* ]]; then
                    DEP_AGE_TYPE="tap"
                else
                    DEP_AGE_TYPE="core"
                fi

                if [[ "$DEP" =~ ^[a-zA-Z0-9@._/-]+$ ]]; then
                    AGE_INFO=$(fetch_pkg_age "$DEP" "$DEP_AGE_TYPE")
                    AGE_DAYS=$(echo "$AGE_INFO" | awk '{print $1}')
                    PUB_DATE=$(echo "$AGE_INFO" | awk '{print $2}')
                else
                    AGE_DAYS=-1
                    PUB_DATE=unknown
                fi

                if [ "$AGE_DAYS" = "-2" ]; then
                    # GitHub API rate limit (issue #84). Must precede the generic
                    # "-lt 0" unknown-age checks below (which -2 also satisfies):
                    # abort with the reset time unless the user opted into fail-open.
                    if [ "$ALLOW_UNKNOWN_AGE" != true ]; then
                        rate_limit_abort "$AGE_INFO" " for dependency $DEP"
                    fi
                    echo "    [age-dep] $DEP — GitHub API rate-limited, allowed by --allow-unknown-age"
                elif [ "$AGE_DAYS" -ge 0 ] 2>/dev/null && [ "$AGE_DAYS" -lt "$MIN_AGE" ]; then
                    echo "    [HOLD-DEP] $DEP $DEP_VER -- released $AGE_DAYS day(s) ago ($PUB_DATE), min-age: $MIN_AGE days"
                    DEP_BLOCKED_HOLD="$DEP_BLOCKED_HOLD $DEP"
                    DEP_BLOCKED_HOLD_REASONS="${DEP_BLOCKED_HOLD_REASONS}    $DEP $DEP_VER: too fresh ($AGE_DAYS days old, min-age $MIN_AGE)"$'\n'
                    continue
                elif [ "$AGE_DAYS" -lt 0 ] 2>/dev/null && [ "$ALLOW_UNKNOWN_AGE" != true ]; then
                    echo "    [HOLD-DEP] $DEP $DEP_VER -- age could not be verified (min-age: $MIN_AGE days); re-run with --allow-unknown-age to override"
                    DEP_BLOCKED_HOLD="$DEP_BLOCKED_HOLD $DEP"
                    DEP_BLOCKED_HOLD_REASONS="${DEP_BLOCKED_HOLD_REASONS}    $DEP $DEP_VER: age could not be verified"$'\n'
                    continue
                elif [ "$AGE_DAYS" -lt 0 ] 2>/dev/null; then
                    echo "    [age-dep] $DEP — age could not be verified, allowed by --allow-unknown-age"
                fi
            fi

            DEP_RESULT=$(python3 "$SCRIPT" brew "$DEP" "$DEP_VER" 2>/dev/null) && DEP_EXIT=0 || DEP_EXIT=$?

            if [ "$DEP_EXIT" -eq 0 ]; then
                echo "    [ok-dep] $DEP $DEP_VER"
                print_scan_notes "$DEP_RESULT"
            elif [ "$DEP_EXIT" -eq 1 ]; then
                # Same relative rule as the top-level scan: block on findings the
                # incoming version ADDS, not on ones it inherits or fixes. Without
                # this, a dep whose newest release still carries any open CVE taints
                # every dependent forever — python@3.12 held pip-cve-gate and
                # shopify-cli that way while the upgrade would have FIXED two of the
                # eleven findings already installed.
                #
                # The extra scan runs only here, on the block path, so it costs one
                # query per FLAGGED dep rather than one per dep — the NVD traffic
                # objection in the design note above does not apply at this volume.
                _DCAND_IDS=$(finding_ids "$DEP_RESULT")
                _DINST_IDS=""
                if [ -n "$DEP_INSTALLED_VER" ]; then
                    _DINST_JSON=$(python3 "$SCRIPT" brew "$DEP" "$DEP_INSTALLED_VER" 2>/dev/null) && _DINST_EXIT=0 || _DINST_EXIT=$?
                    [ "$_DINST_EXIT" -eq 1 ] && _DINST_IDS=$(finding_ids "$_DINST_JSON")
                fi
                _DNEW_IDS=""
                if [ -n "$_DCAND_IDS" ] && [ -n "$_DINST_IDS" ]; then
                    _DNEW_IDS=$(new_findings "$_DCAND_IDS" "$_DINST_IDS")
                fi
                if [ -n "$_DCAND_IDS" ] && [ -n "$_DINST_IDS" ] && [ -z "$_DNEW_IDS" ]; then
                    _dn=$(printf '%s\n' "$_DCAND_IDS" | grep -c .)
                    _dni=$(printf '%s\n' "$_DINST_IDS" | grep -c .)
                    if [ "$_dn" -eq "$_dni" ]; then
                        echo "    [SAME-DEP] $DEP $DEP_VER -- same $_dn finding(s) as installed $DEP_INSTALLED_VER, upgrade does not change exposure"
                        print_scan_notes "$DEP_RESULT"
                    else
                        echo "    [IMPROVES-DEP] $DEP $DEP_VER -- fixes $((_dni - _dn)) of $_dni finding(s) from installed $DEP_INSTALLED_VER, introduces none"
                        print_scan_notes "$DEP_RESULT"
                    fi
                else
                    echo "    [VULN-DEP] $DEP $DEP_VER -- vulnerabilities found"
                    SUMMARY=$(first_vuln_summary "$DEP_RESULT")
                    DEP_BLOCKED_VULN="$DEP_BLOCKED_VULN $DEP"
                    DEP_BLOCKED_VULN_REASONS="${DEP_BLOCKED_VULN_REASONS}    $DEP $DEP_VER: ${SUMMARY:-vulnerabilities reported}"$'\n'
                fi
            else
                _why=$(first_failure_reason "$DEP_RESULT")
                echo "    [skip-dep] $DEP $DEP_VER -- check failed (${_why:-network or DB error})"
                DEP_SKIPPED="$DEP_SKIPPED $DEP"
                if echo "$DEP_RESULT" | grep -q '"rate_limited": *true'; then
                    RATE_LIMIT_SEEN=true
                fi
            fi
        done
        phase_took "dependency checks" "$_phase_start"

        if [ -n "$DEP_SKIPPED" ]; then
            echo ""
            echo "  Note: dep checks could not be completed for:$DEP_SKIPPED"
            echo "  An unverifiable dependency is treated like a flagged one: its dependents"
            echo "  are held. Re-run later, or use --no-deps to skip dependency checks."
            note_rate_limit
        fi

        # Distinct sections for vulnerable vs. too-fresh vs. unverifiable: they
        # are different risk signals. All three taint their dependents — the
        # main pass already fails closed on a package whose own check failed,
        # and a dependency the scanner could not answer for is the same
        # unknown, one level down. It used to ride in under a "clean" parent.
        if [ -n "$DEP_BLOCKED_VULN" ] || [ -n "$DEP_BLOCKED_HOLD" ] || [ -n "$DEP_SKIPPED" ]; then
            # Which top-level packages depend on a flagged dep? Only those have
            # to be held; the rest of the batch is unaffected and upgradable.
            #
            # This is what makes the partition safe. brew resolves dependencies
            # itself, so naming package A on the command line lets brew upgrade
            # the flagged dep D underneath it. Holding every package whose
            # (recursive) dep closure contains D is therefore not a convenience
            # — it is the only way to keep D off brew's cmdline.
            # Membership is tested with `case`, not `grep -qw`. Homebrew names
            # carry regex metacharacters — `grep -qw llama.cpp` matches the
            # unrelated `llamaXcpp`, because `.` is a wildcard in a BRE. In the
            # safe-list filter below that over-match runs the UNSAFE way: a
            # tainted package could be judged safe and handed to brew. `case`
            # patterns match literally here, so a package can only match itself.
            DEP_TAINTED_PKGS=""
            for _bad in $DEP_BLOCKED_VULN $DEP_BLOCKED_HOLD $DEP_SKIPPED; do
                for _own in ${DEP_OWNERS_ARR[@]+"${DEP_OWNERS_ARR[@]}"}; do
                    _own_dep=${_own%|*}
                    _own_pkg=${_own##*|}
                    if [ "$_own_dep" = "$_bad" ]; then
                        case " $DEP_TAINTED_PKGS " in
                            *" $_own_pkg "*) ;;
                            *) DEP_TAINTED_PKGS="$DEP_TAINTED_PKGS $_own_pkg" ;;
                        esac
                    fi
                done
            done

            DEP_SAFE_PKGS=""
            for _p in $CLEAN_PKGS; do
                case " $DEP_TAINTED_PKGS " in
                    *" $_p "*) ;;
                    *) DEP_SAFE_PKGS="$DEP_SAFE_PKGS $_p" ;;
                esac
            done

            echo ""
            if [ -n "$DEP_BLOCKED_VULN" ]; then
                echo "WARNING: incoming dependencies have known CVEs:"
                printf "%s" "$DEP_BLOCKED_VULN_REASONS"
            fi
            if [ -n "$DEP_BLOCKED_HOLD" ]; then
                echo "Incoming dependencies are below --min-age:"
                printf "%s" "$DEP_BLOCKED_HOLD_REASONS"
            fi
            if [ -n "$DEP_SKIPPED" ]; then
                echo "Incoming dependencies could not be checked:$DEP_SKIPPED"
            fi
            echo "Proceeding will let brew upgrade them anyway."
            if [ -n "$DEP_TAINTED_PKGS" ]; then
                echo "Depends on a flagged dependency:$DEP_TAINTED_PKGS"
            fi
            if [ -n "$DEP_SAFE_PKGS" ]; then
                echo "Unaffected and safe to upgrade now:$DEP_SAFE_PKGS"
            else
                echo "No package in this batch is free of the flagged dependencies."
            fi

            if [ "$SKIP_UNSAFE" = true ]; then
                echo "[--skip-unsafe] holding:$DEP_TAINTED_PKGS"
                DEP_PARTIAL=true
            elif [ "$AUTO_YES" = true ]; then
                # Visible on stderr so it lands in CI logs even when stdout is redirected
                echo "[--yes] continuing despite dep warnings — review the lines above" >&2
            else
                # Answering "no" used to cancel the ENTIRE job, so a single
                # too-fresh dep blocked every unrelated package in the batch
                # (#98). `s` upgrades only the packages that don't touch it.
                echo "Continue upgrade?"
                echo "  [y] yes — upgrade everything, including the flagged dependencies"
                # Offer [s] only when it would actually do something. With no
                # unaffected package left, skipping is a guaranteed no-op — the
                # line above already said so — and offering it anyway reads as a
                # safe way out that silently upgrades nothing.
                if [ -n "$DEP_SAFE_PKGS" ]; then
                    echo "  [s] skip — upgrade only the unaffected packages above"
                fi
                echo "  [N] no  — cancel the whole upgrade (default)"
                read -r DEP_CONFIRM
                if [[ "$DEP_CONFIRM" =~ ^[sS] ]]; then
                    DEP_PARTIAL=true
                elif [[ ! "$DEP_CONFIRM" =~ ^[yY] ]]; then
                    echo "Cancelled."
                    exit 0
                fi
            fi

            if [ "$DEP_PARTIAL" = true ]; then
                if [ -z "$DEP_SAFE_PKGS" ]; then
                    echo ""
                    echo "Nothing left to upgrade after holding the affected packages."
                    exit 0
                fi
                # Re-filter the formula/cask lists so brew only ever sees the
                # safe subset. Rebuilding both lists (rather than CLEAN_PKGS
                # alone) matters: the upgrade step passes them to brew
                # separately, and a tainted cask left in CLEAN_PKGS_CASKS would
                # still reach the cmdline.
                _SAFE_FORMULAE=""
                for _p in $CLEAN_PKGS_FORMULAE; do
                    case " $DEP_SAFE_PKGS " in
                        *" $_p "*) _SAFE_FORMULAE="$_SAFE_FORMULAE $_p" ;;
                    esac
                done
                _SAFE_CASKS=""
                for _p in $CLEAN_PKGS_CASKS; do
                    case " $DEP_SAFE_PKGS " in
                        *" $_p "*) _SAFE_CASKS="$_SAFE_CASKS $_p" ;;
                    esac
                done
                CLEAN_PKGS_FORMULAE="$_SAFE_FORMULAE"
                CLEAN_PKGS_CASKS="$_SAFE_CASKS"
                CLEAN_PKGS="${CLEAN_PKGS_FORMULAE}${CLEAN_PKGS_CASKS}"
                DEP_HELD_PKGS="$DEP_TAINTED_PKGS"
                # Add BOTH the held dependents and the flagged deps themselves
                # to EXCLUDE_PKGS. That list is `brew pin`-ed around the upgrade,
                # and pinning the flagged dep is the actual guarantee: dropping a
                # dependent from brew's cmdline is not enough on its own, because
                # some other package's closure could still drag the dep in. The
                # pin makes brew refuse to touch it either way.
                EXCLUDE_PKGS="$EXCLUDE_PKGS $DEP_TAINTED_PKGS $DEP_BLOCKED_VULN $DEP_BLOCKED_HOLD $DEP_SKIPPED"
            fi
        fi
    fi
elif [ "$CHECK_DEPS" = false ]; then
    echo ""
    echo "Dependency check skipped (--no-deps / BREW_SAFE_NO_DEPS=1)."
fi

# Upgrade
if [ -z "$CLEAN_PKGS" ]; then
    echo ""
    echo "No verified clean packages to upgrade."
else
    echo ""
    if [ -n "$DEP_HELD_PKGS" ]; then
        echo "Held (flagged dependency):$DEP_HELD_PKGS"
    fi
    if [ -n "$CLEAN_PKGS_FORMULAE" ]; then
        echo "Clean formulae to upgrade:$CLEAN_PKGS_FORMULAE"
    fi
    if [ -n "$CLEAN_PKGS_CASKS" ]; then
        echo "Clean casks to upgrade:$CLEAN_PKGS_CASKS"
    fi
    echo ""
    if [ "$AUTO_YES" = true ]; then
        CONFIRM="y"
    else
        # Trim rather than compare against a literal run of spaces. EXCLUDE_PKGS
        # joins four (now more) possibly-empty lists, so "nothing excluded" is a
        # string of N-1 spaces — it was compared against exactly two, so the
        # all-clean branch could never be reached and a first run with nothing
        # blocked still got the cautious "[y/N]" prompt. Adding more lists to
        # the join would have silently changed the count again.
        # Parameter expansion, not xargs: xargs parses quotes and backslashes,
        # so malformed content could collapse to empty and silently select the
        # affirmative "All clean" default.
        EXCLUDE_PKGS_TRIMMED="${EXCLUDE_PKGS//[[:space:]]/}"
        # echo + read rather than `read -rp`: bash only renders a -p prompt when
        # stdin is a terminal, so under a pipe (CI, `yes |`, the test suite) the
        # question was never shown at all — the run just looked like it stopped.
        # Same reasoning as the SHA prompt above.
        if [ -z "$EXCLUDE_PKGS_TRIMMED" ]; then
            echo "All clean. Run brew upgrade? [Y/n] "
            read -r CONFIRM
            [[ "$CONFIRM" =~ ^[nN] ]] && CONFIRM="n" || CONFIRM="y"
        else
            echo "Upgrade clean packages? Excluded ones will be skipped. [y/N] "
            read -r CONFIRM
            [[ "$CONFIRM" =~ ^[yY] ]] && CONFIRM="y" || CONFIRM="n"
        fi
    fi
    if [ "$CONFIRM" = "y" ]; then
        # Pin excluded formulae so brew can't upgrade them as dependencies.
        #
        # The pins are OURS for the duration of the upgrade and must never
        # outlive it: a Ctrl-C or crash between pin and unpin used to leave every
        # excluded formula pinned silently, and plain `brew upgrade` skips pinned
        # formulae without a word — so a user sat on pinned VULNERABLE packages
        # indefinitely, believing they upgrade normally. Hence:
        #   - pre-existing pins are recorded first and left alone (they are the
        #     user's, not ours — unpinning them would be a different bug);
        #   - every pin we add goes into SAFE_PINNED_BY_US;
        #   - a trap on EXIT/INT/TERM unpins whatever is still in that list, so
        #     an interrupt anywhere in the bracket — during the upgrade OR during
        #     the unpin loop itself — still ends with our pins gone, and says so.
        PREEXISTING_PINS=" $(brew list --pinned 2>/dev/null | tr '\n' ' ') "
        SAFE_PINNED_BY_US=""
        _safe_unpin_ours() {
            # Idempotent: the normal path empties the list before the EXIT trap
            # fires, so a clean run never unpins twice. On an abnormal path the
            # list still holds what is left and we release it here.
            local _left="$SAFE_PINNED_BY_US" _p
            [ -z "${_left// /}" ] && return 0
            echo "" >&2
            echo "Interrupted — releasing the pins brew-safe-upgrade set:$_left" >&2
            for _p in $_left; do
                if brew unpin "$_p" >/dev/null 2>&1; then
                    SAFE_PINNED_BY_US="${SAFE_PINNED_BY_US// $_p / }"
                else
                    echo "  could not unpin $_p — check: brew list --pinned" >&2
                fi
            done
            SAFE_PINNED_BY_US=""
        }
        _safe_on_signal() {
            _safe_unpin_ours
            trap - EXIT
            exit 130
        }
        trap _safe_unpin_ours EXIT
        trap _safe_on_signal INT TERM
        for pkg in $EXCLUDE_PKGS; do
            if [ -n "$pkg" ]; then
                case "$PREEXISTING_PINS" in
                    *" $pkg "*) continue ;;
                esac
                # Claim ownership BEFORE the pin lands: a Ctrl-C that reaches
                # `brew pin` after it wrote the pin but before we recorded it
                # would leave a pin the trap does not know about. Claiming
                # first and unclaiming on failure closes that window; an unpin
                # of something that was never pinned is harmless.
                SAFE_PINNED_BY_US="$SAFE_PINNED_BY_US $pkg "
                if ! brew pin "$pkg" 2>/dev/null; then
                    SAFE_PINNED_BY_US="${SAFE_PINNED_BY_US// $pkg / }"
                fi
            fi
        done

        # Upgrade formulae and casks separately by name
        if [ -n "$CLEAN_PKGS_FORMULAE" ]; then
            # shellcheck disable=SC2086
            brew upgrade --formula $CLEAN_PKGS_FORMULAE </dev/null 2>&1 || true
        fi
        if [ -n "$CLEAN_PKGS_CASKS" ]; then
            # shellcheck disable=SC2086
            brew upgrade --cask $CLEAN_PKGS_CASKS </dev/null 2>&1 || true
        fi

        # Unpin what WE pinned (pre-existing pins stay). Each success is struck
        # from the list as it happens, so an interrupt mid-loop hands the trap
        # exactly the remainder.
        for pkg in $SAFE_PINNED_BY_US; do
            if brew unpin "$pkg" 2>/dev/null; then
                SAFE_PINNED_BY_US="${SAFE_PINNED_BY_US// $pkg / }"
            else
                echo "Warning: could not unpin $pkg — run: brew unpin $pkg" >&2
            fi
        done
        SAFE_PINNED_BY_US=""
        trap - EXIT INT TERM

        # Did the verdict actually land?
        #
        # `brew upgrade` refuses individual packages and still exits 0 for the
        # batch, and the `|| true` above swallows even the non-zero case. The
        # common trigger is our own pin bracket: a clean dependent that needs the
        # latest of a dependency this run pinned makes brew print
        #   Error: You must `brew unpin libvpx sdl3` as installing ffmpeg requires…
        # and skip it. Seen live: ffmpeg and gnupg were announced as clean, their
        # bottles were downloaded, neither was poured — and the run still closed
        # with "Done." and exit 0. The gate had told the user those two upgraded.
        #
        # Re-ask brew what is still outdated rather than parsing its error text.
        # The wording differs per reason (pinned dependency, no bottle, build
        # failure, network) and brew is free to change it; the end state is the
        # same question in every case and answers reasons we have not seen yet.
        # This runs AFTER the unpin loop so it reports on the settled state, not
        # on packages brew is merely refusing while our pins are up.
        UPGRADE_FAILED_PKGS=""
        # The re-check reads --json=v2, NOT --quiet. Both spellings are "the
        # outdated list", but they are not the same string: the JSON carries
        # `f.full_name` while --quiet prints `f.full_installed_specified_name`,
        # which is the ALIAS recorded in the install receipt when one was used
        # (formula.rb). A formula installed as `brew install postgresql` is
        # `postgresql@18` in CLEAN_PKGS and `postgresql` under --quiet, so
        # neither the full name nor the basename matched and a genuinely refused
        # upgrade read as landed — silent, exit 0, the fail-open direction for
        # this whole feature. CLEAN_PKGS was itself built from --json=v2, so
        # using it here means both sides are the same field by construction and
        # an exact match is enough.
        #
        # Each namespace is queried only when something in it was announced, and
        # a failure marks only that namespace unverified. Querying casks during a
        # formula-only run meant a broken cask tap (or a brew where --cask errors
        # at all — linuxbrew is one of this repo's dogfood beds) could end a
        # perfectly successful formula upgrade with "could not verify" and exit 1.
        #
        # `if ! _x=$(...)` rather than `_x=$(... | tr ...); rc=$?`: the pipeline
        # form only reported brew's failure because `set -o pipefail` is on ~2000
        # lines up. If that were ever narrowed the detection would die silently
        # and the run would go back to asserting success it never checked, which
        # is precisely the bug this block exists to prevent.
        _outdated_names() { # $1 = raw --json=v2 output, $2 = formulae|casks
            printf '%s' "$1" | python3 -c "
import sys, json
try:
    for x in json.load(sys.stdin).get(sys.argv[1], []):
        n = x.get('name', '')
        if n:
            print(n)
except Exception:
    pass
" "$2" 2>/dev/null
        }
        _check_landed() { # $1 = announced packages, $2 = the matching outdated list
            for pkg in $1; do
                [ -z "$pkg" ] && continue
                case "$2" in
                    *" $pkg "*) ;;
                    *) continue ;;
                esac
                # A package the USER pinned is listed by `brew outdated` (brew
                # annotates it "[pinned at ...]" rather than filtering it) and is
                # refused by `brew upgrade` by definition. That is a standing
                # choice, not a failed upgrade: reporting it would fire on every
                # single run, forever, and take exit 1 with it. PREEXISTING_PINS
                # is the set recorded before this run added any pins of its own,
                # so it is exactly "pinned by the user"; ours are released by
                # here. `brew list --pinned` prints bare names, hence the
                # basename arm on this match only.
                _bn="${pkg##*/}"
                case "$PREEXISTING_PINS" in
                    *" $pkg "* | *" $_bn "*) continue ;;
                esac
                UPGRADE_FAILED_PKGS="$UPGRADE_FAILED_PKGS $pkg"
            done
        }
        if [ -n "${CLEAN_PKGS_FORMULAE// /}" ]; then
            if _recheck_json=$(HOMEBREW_NO_AUTO_UPDATE=1 brew outdated --json=v2 --formula 2>/dev/null); then
                _check_landed "$CLEAN_PKGS_FORMULAE" " $(_outdated_names "$_recheck_json" formulae | tr '\n' ' ') "
            else
                UPGRADE_UNVERIFIED=1
            fi
        fi
        if [ -n "${CLEAN_PKGS_CASKS// /}" ]; then
            if _recheck_json=$(HOMEBREW_NO_AUTO_UPDATE=1 brew outdated --json=v2 --cask 2>/dev/null); then
                _check_landed "$CLEAN_PKGS_CASKS" " $(_outdated_names "$_recheck_json" casks | tr '\n' ' ') "
            else
                UPGRADE_UNVERIFIED=1
            fi
        fi
        if [ -n "$UPGRADE_UNVERIFIED" ]; then
            echo ""
            echo "Warning: could not verify that the upgrades landed —"
            echo "  'brew outdated' failed when re-checked. The packages above may"
            echo "  or may not have upgraded; check with 'brew outdated' yourself."
        elif [ -n "$UPGRADE_FAILED_PKGS" ]; then
            echo ""
            echo "Warning: passed the gate but did NOT upgrade:$UPGRADE_FAILED_PKGS"
            echo "  Still on the installed version. brew's output above says why —"
            echo "  most often a dependency this run pinned (\"You must \`brew unpin"
            echo "  ...\`\") because that dependency could not be vetted, or a formula"
            echo "  with no bottle. Nothing unsafe was installed; the upgrade simply"
            echo "  did not happen. Re-run once the blocking dependency clears."
        fi
    fi
fi

echo ""
echo "Done."

# Tampering must surface as a non-zero exit in CI / shell pipelines, even
# when other clean packages upgraded successfully alongside.
if [ -n "$TAMPERED_PKGS" ]; then
    exit 1
fi

# So must a package that cleared the gate and then failed to install. "Done."
# plus exit 0 is a claim that the verdict was carried out; when it was not, a
# script that only reads the exit code would go on believing the upgrade
# landed. Not a security event like tampering — hence the distinct wording
# above — but still a failed run.
if [ -n "$UPGRADE_FAILED_PKGS" ]; then
    exit 1
fi

# And so must an upgrade we could not verify at all. Exiting 0 here would assert
# the one thing the run just failed to establish — in a fail-closed tool, "I
# could not check" is not "it is fine".
if [ -n "$UPGRADE_UNVERIFIED" ]; then
    exit 1
fi
